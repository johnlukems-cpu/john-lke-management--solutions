---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Photo from '@/components/Photo.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { priceLabel, services, servicePath } from '@/data/services';
import { contactHref } from '@/data/navigation';
import { breadcrumbSchema } from '@/lib/schema';

const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [{ name: 'Diensten', path: '/diensten' }];
---

<BaseLayout
  title="Diensten: financiële administratie uitbesteden | John-Luke"
  rawTitle
  description="Verwerking, debiteuren en crediteuren, controles, afsluitingen, achterstanden en tijdelijke capaciteit voor Nederlandse kantoren en mkb-bedrijven."
  schema={[
    breadcrumbSchema(origin, crumbs),
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${origin}${servicePath(s)}` })),
    },
  ]}
>
  <PageHero
    eyebrow="Diensten"
    title="Diensten voor kantoren en mkb-bedrijven"
    intro="Zes diensten voor Nederlandse administratiekantoren, accountantskantoren en mkb-bedrijven: van dagelijkse verwerking en controles tot afsluitingen, achterstanden en tijdelijke capaciteit. Altijd in uw software en volgens uw werkwijze — gericht op langdurige samenwerking. Verwerking financiële administratie vanaf €12 per uur."
    crumbs={crumbs}
  >
    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a href={contactHref()} class="btn btn-gold">Plan een kennismakingsgesprek <Icon name="arrowRight" class="size-4" /></a>
    </div>
  </PageHero>

  <section class="section bg-paper" aria-label="Overzicht van de diensten">
    <div class="container-site space-y-20 lg:space-y-28">
      {services.map((s, i) => (
        <article class="grid items-center gap-10 lg:grid-cols-2 lg:gap-20" aria-labelledby={`dienst-${s.slug}`}>
          <Photo slot={s.photo} class:list={['reveal aspect-[4/3] min-w-0', i % 2 === 1 && 'lg:order-last']} />
          <div class="reveal min-w-0">
            <p class="eyebrow mb-5">{s.availability === 'op-aanvraag' ? 'Op aanvraag' : 'Standaarddienst'} · {s.subtitle}</p>
            <h2 id={`dienst-${s.slug}`} class="text-[1.625rem] leading-[1.15] min-[400px]:text-[2rem] sm:text-[2.5rem]">{s.name}</h2>
            <p class="mt-5 text-lg leading-relaxed text-muted">{s.summary}</p>
            <p class="mt-4 font-semibold text-ink">{priceLabel(s)}</p>
            <ul class="mt-7 grid gap-3 sm:grid-cols-2">
              {s.tasks.map((t) => (
                <li class="flex items-start gap-3 text-[0.9375rem] text-ink"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-gold-deep" stroke={2.2} /><span class="min-w-0">{t}</span></li>
              ))}
            </ul>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <a href={servicePath(s)} class="btn btn-primary">Bekijk deze dienst <Icon name="arrowRight" class="size-4" /></a>
              <a href={contactHref(s.slug)} class="btn btn-outline">Bespreek deze dienst</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-tight bg-mist" aria-labelledby="afbakening-title">
    <div class="container-site grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <h2 id="afbakening-title" class="reveal text-2xl">Wat wij wel en niet doen</h2>
      <div class="reveal space-y-4 leading-relaxed text-muted">
        <p>Wij verzorgen de administratieve verwerking en voorbereiding: wij boeken, controleren, sluiten aan en signaleren. Uw kantoor beoordeelt, accordeert en dient in.</p>
        <p>Wij geven geen fiscaal advies, dienen geen aangiften in, ondertekenen geen jaarstukken en voeren geen wettelijke controle (audit) uit. Die verdeling leggen wij vooraf schriftelijk vast.</p>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Financiële outsourcing"
    title="Meer capaciteit voor uw kantoor nodig?"
    text="Bespreek met ons welke werkzaamheden u wilt uitbesteden. Wij starten graag met een afgebakende pilot."
    primary={{ label: 'Plan een kennismakingsgesprek', href: contactHref() }}
    secondary={{ label: 'Bekijk onze softwarekennis', href: '/software' }}
  />
</BaseLayout>
