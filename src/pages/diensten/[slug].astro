---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Photo from '@/components/Photo.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { services, servicePath, type Service } from '@/data/services';
import { contactHref } from '@/data/navigation';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';
import { site } from '@/config/site';

export const getStaticPaths = (() =>
  services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}
const { service } = Astro.props;
const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [
  { name: 'Diensten', path: '/diensten' },
  { name: service.name, path: servicePath(service) },
];
const others = services.filter((s) => s.slug !== service.slug);
const cta = contactHref(service.slug);
---

<BaseLayout
  title={service.seoTitle}
  rawTitle
  description={service.seoDescription}
  schema={[serviceSchema(origin, service), breadcrumbSchema(origin, crumbs), faqSchema(service.faq)]}
>
  <PageHero eyebrow={`${service.availability === 'op-aanvraag' ? 'Op aanvraag' : 'Standaarddienst'} · ${service.subtitle}`} title={service.heading} intro={service.intro[0]} crumbs={crumbs}>
    <p class="mt-6 text-lg text-on-dark"><span class="font-semibold text-gold-light">{site.pricing.label}</span> · gericht op langdurige samenwerking</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={cta} class="btn btn-gold">Bespreek outsourcing <Icon name="arrowRight" class="size-4" /></a>
      <a href={cta} class="btn btn-outline-light">Plan een kennismakingsgesprek</a>
    </div>
  </PageHero>

  <section class="section bg-paper" aria-labelledby="werk-title">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <Photo slot={service.photo} class="reveal aspect-[4/3]" priority />
        <div class="reveal mt-8 space-y-4 text-lg leading-relaxed text-muted">
          {service.intro.slice(1).map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div>
        <SectionHeading id="werk-title" eyebrow="Werkzaamheden" title="Wat wij voor uw kantoor verzorgen" />
        <ul class="reveal mt-8 divide-y divide-line border-y border-line">
          {service.tasks.map((task) => (
            <li class="flex items-start gap-4 py-3.5">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-ink text-gold-light"><Icon name="check" class="size-3.5" stroke={2.5} /></span>
              <span class="text-lg text-ink">{task}</span>
            </li>
          ))}
        </ul>
        {service.onRequest && (
          <div class="reveal mt-6">
            <p class="text-sm font-semibold text-ink">Op aanvraag</p>
            <ul class="mt-2 space-y-2">
              {service.onRequest.map((t) => <li class="flex items-start gap-3 text-muted"><Icon name="arrowRight" class="mt-1 size-4 shrink-0 text-gold-deep" />{t}</li>)}
            </ul>
          </div>
        )}
        <div class="reveal mt-8 border border-line bg-paper p-6">
          <p class="text-sm font-semibold tracking-wide text-ink uppercase">Tarief</p>
          <p class="mt-2 font-display text-3xl text-ink">{site.pricing.label}</p>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">
            Het definitieve tarief hangt af van het volume, de werkzaamheden en de looptijd. Wij bouwen op langdurige
            samenwerking: bij een vaste samenwerking maken wij heldere afspraken over capaciteit en tarief.
          </p>
        </div>
        {service.scopeNote && (
          <p class="reveal mt-8 border-l-2 border-gold bg-mist p-5 text-[0.9375rem] leading-relaxed text-muted">{service.scopeNote}</p>
        )}
      </div>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="voordelen-title">
    <div class="container-site">
      <SectionHeading id="voordelen-title" eyebrow="Wat het uw kantoor oplevert" title="Voordelen voor uw kantoor" />
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {service.benefits.map((b, i) => (
          <li class="reveal border-t-2 border-ink bg-paper p-7">
            <span class="font-display text-sm text-gold-deep">0{i + 1}</span>
            <h3 class="mt-3 text-xl">{b.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{b.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="faq-title">
    <div class="container-site grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <SectionHeading id="faq-title" eyebrow="Vragen" title={`Vragen over ${service.name.toLowerCase()}`} />
        <a href={cta} class="link-arrow reveal mt-8">Bespreek uw outsourcingmogelijkheden <Icon name="arrowRight" class="size-4" /></a>
      </div>
      <FaqList items={service.faq} />
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="andere-title">
    <div class="container-site">
      <SectionHeading id="andere-title" eyebrow="Diensten" title="Onze andere diensten" />
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((s) => (
          <li class="reveal">
            <a href={servicePath(s)} class="group flex h-full flex-col border border-line bg-paper p-7 transition-colors hover:border-ink">
              <Icon name={s.icon} class="size-7 text-gold-deep" stroke={1.3} />
              <h3 class="mt-5 text-xl">{s.name}</h3>
              <p class="mt-1 text-sm font-medium text-gold-deep">{s.subtitle}</p>
              <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-muted">{s.summary}</p>
              <span class="link-arrow mt-5 self-start">Bekijk dienst <Icon name="arrowRight" class="size-4" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    eyebrow="Financial Outsourcing"
    title="Meer capaciteit voor uw kantoor nodig?"
    text="Bespreek met ons hoe wij uw kantoor kunnen ondersteunen bij financiële administratieve werkzaamheden."
    primary={{ label: 'Plan een kennismakingsgesprek', href: cta }}
    secondary={{ label: 'Vraag outsourcing aan', href: cta }}
  />
</BaseLayout>
