---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Photo from '@/components/Photo.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { services, servicePath, type Service } from '@/data/services';
import { whatsappUrl } from '@/config/site';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';

export const getStaticPaths = (() =>
  services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}
const { service } = Astro.props;
const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [
  { name: 'Diensten', path: '/diensten' },
  { name: service.name, path: servicePath(service) },
];
const others = services.filter((s) => s.slug !== service.slug);
const contactHref = `/contact?onderwerp=kennismaking&dienst=${service.slug}#formulier`;
const wa = whatsappUrl(`Goedendag, ik heb een vraag over ${service.name.toLowerCase()} (${service.subtitle.toLowerCase()}).`);
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  schema={[serviceSchema(origin, service), breadcrumbSchema(origin, crumbs), faqSchema(service.faq)]}
>
  <PageHero eyebrow={`${service.name} · ${service.subtitle}`} title={service.heading} intro={service.intro[0]} crumbs={crumbs}>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href={contactHref} class="btn btn-gold">Plan een kennismaking <Icon name="arrowRight" class="size-4" /></a>
      {wa && <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-outline-light"><Icon name="whatsapp" class="size-5" />Stel uw vraag via WhatsApp</a>}
    </div>
  </PageHero>

  <!-- Introductie + werkzaamheden -->
  <section class="section bg-paper" aria-labelledby="werk-title">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <Photo slot={service.photo} class="reveal aspect-[4/3]" priority />
        <div class="reveal mt-8 space-y-4 text-lg leading-relaxed text-muted">
          {service.intro.slice(1).map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div>
        <SectionHeading id="werk-title" eyebrow="Werkzaamheden" title={`Wat wij voor u verzorgen`} />
        <ul class="reveal mt-8 divide-y divide-line border-y border-line">
          {service.tasks.map((task) => (
            <li class="flex items-start gap-4 py-4">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-ink text-gold-light"><Icon name="check" class="size-3.5" stroke={2.5} /></span>
              <span class="text-lg text-ink">{task}</span>
            </li>
          ))}
        </ul>
        {service.scopeNote && (
          <p class="reveal mt-8 border-l-2 border-gold bg-mist p-5 text-[0.9375rem] leading-relaxed text-muted">{service.scopeNote}</p>
        )}
      </div>
    </div>
  </section>

  <!-- Wat het u oplevert -->
  <section class="section bg-mist" aria-labelledby="voordelen-title">
    <div class="container-site">
      <SectionHeading id="voordelen-title" eyebrow="Wat het u oplevert" title={`${service.name} in goede handen`} />
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {service.benefits.map((b, i) => (
          <li class="reveal border-t-2 border-ink bg-paper p-7">
            <span class="font-display text-sm text-gold-deep">0{i + 1}</span>
            <h3 class="mt-3 text-xl">{b.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{b.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Voor wie + FAQ -->
  <section class="section bg-paper" aria-labelledby="voorwie-title">
    <div class="container-site grid gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div>
        <SectionHeading id="voorwie-title" eyebrow="Voor wie" title="Voor welke ondernemingen?" />
        <ul class="reveal mt-8 space-y-4">
          {service.audience.map((a) => (
            <li class="flex items-start gap-3 text-ink"><Icon name="arrowRight" class="mt-1 size-4 shrink-0 text-gold-deep" />{a}</li>
          ))}
        </ul>
        <p class="reveal mt-8 text-muted">Tarieven in SRD, afgestemd op de omvang van uw administratie. U ontvangt na de kennismaking een helder voorstel.</p>
      </div>
      <div>
        <h2 class="reveal text-[1.75rem] sm:text-[2rem]">Vragen over {service.name.toLowerCase()}</h2>
        <div class="mt-6"><FaqList items={service.faq} /></div>
      </div>
    </div>
  </section>

  <!-- Andere diensten -->
  <section class="section bg-mist" aria-labelledby="andere-title">
    <div class="container-site">
      <SectionHeading id="andere-title" eyebrow="Ook interessant" title="Onze andere diensten" />
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {others.map((s) => (
          <li class="reveal">
            <a href={servicePath(s)} class="group flex h-full flex-col border border-line bg-paper p-7 transition-colors hover:border-ink">
              <Icon name={s.icon} class="size-7 text-gold-deep" stroke={1.3} />
              <h3 class="mt-5 text-xl">{s.name}</h3>
              <p class="mt-1 text-sm font-medium text-gold-deep">{s.subtitle}</p>
              <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-muted">{s.summary}</p>
              <span class="link-arrow mt-5 self-start">Bekijk {s.name} <Icon name="arrowRight" class="size-4" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title={`Uw ${service.name.toLowerCase()} uit handen geven?`} />
</BaseLayout>
