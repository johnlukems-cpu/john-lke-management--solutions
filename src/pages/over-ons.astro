---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Photo from '@/components/Photo.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaBand from '@/components/CtaBand.astro';
import { experience, reasons } from '@/data/content';
import { contactHref } from '@/data/navigation';
import { breadcrumbSchema } from '@/lib/schema';
import { Picture } from 'astro:assets';
import { site } from '@/config/site';
import { owner, showOwner, getOwnerPhoto } from '@/config/owner';
const ownerPhoto = await getOwnerPhoto();

const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [{ name: 'Over ons', path: '/over-ons' }];
const values = [
  { title: 'Betrouwbaarheid', text: 'Afspraken over werkzaamheden, planning en verantwoordelijkheden worden vooraf vastgelegd en nagekomen.' },
  { title: 'Nauwkeurigheid', text: 'Vaste checklists en een tweede controle bij iedere werkzaamheid.' },
  { title: 'Heldere communicatie', text: 'Een vast aanspreekpunt, korte lijnen en een vaste terugkoppeling per week.' },
  { title: 'Professionele samenwerking', text: 'Wij werken binnen uw werkwijze en respecteren de verdeling van verantwoordelijkheden.' },
  { title: 'Vertrouwelijkheid', text: 'Zorgvuldige omgang met financiële gegevens, met afspraken over toegang en gegevensverwerking.' },
  { title: 'Langdurige relaties', text: 'Wij bouwen samenwerkingen voor de lange termijn, met kennis van uw kantoor en uw administraties.' },
];
---

<BaseLayout
  title="Over ons | John-Luke Finance Outsourcing"
  rawTitle
  description="John-Luke Finance Outsourcing: partner in financiële administratieve outsourcing vanuit Suriname, voor Nederlandse kantoren en mkb-bedrijven."
  schema={[breadcrumbSchema(origin, crumbs)]}
>
  <PageHero eyebrow="Over ons" title="Uw partner achter de financiële verwerking." intro="Wij leveren Nederlandse administratiekantoren, accountantskantoren en mkb-bedrijven betrouwbare capaciteit voor de financiële administratie — vanuit Suriname, in de software die zij al gebruiken." crumbs={crumbs} />

  <section class="section bg-off-white" aria-labelledby="wie-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading id="wie-title" eyebrow="Wie wij zijn" title="Een gespecialiseerde partner in financiële outsourcing" />
        <div class="reveal mt-6 space-y-4 text-lg leading-relaxed text-muted">
          <p>
            John-Luke Finance Outsourcing levert financiële administratieve outsourcing aan Nederlandse
            administratiekantoren, accountantskantoren en mkb-bedrijven. Vanuit Suriname bieden wij flexibele ondersteuning op afstand, in
            gangbare boekhoudpakketten zoals Nmbrs Accounting (voorheen Yuki), AFAS Profit, AFAS SB en Exact Online.
          </p>
          <p>
            Wij zijn een jong en bewust kleinschalig bedrijf: de eigenaar is persoonlijk betrokken bij elke samenwerking.
            Groei van ons team volgt op groei van het werk, zodat kwaliteit en continuïteit voorop blijven staan.
          </p>
          <p>
            Wij brengen meer dan 10 jaar ervaring in administratie mee, waarvan meer dan 3 jaar met Nederlandse
            administraties en btw. Die praktijkkennis combineren wij met moderne boekhoudsoftware en een gestructureerde
            werkwijze.
          </p>
        </div>
      </div>
      <Photo slot="intro" class="reveal aspect-[4/3]" />
    </div>
  </section>

  <section class="section lines-dark on-dark bg-midnight-blue text-off-white" aria-labelledby="missie-title">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <p class="eyebrow mb-5">Missie</p>
        <h2 id="missie-title" class="text-[1.75rem] leading-snug !text-off-white sm:text-[2rem]">Waar wij voor staan</h2>
        <p class="mt-5 text-lg leading-relaxed text-on-dark-muted">
          Wij ondersteunen Nederlandse kantoren en mkb-bedrijven met betrouwbare, flexibele en
          kwalitatieve administratieve outsourcing, zodat zij hun capaciteit kunnen vergroten en hun tijd kunnen besteden aan advies,
          beoordeling en hun klanten.
        </p>
      </div>
      <div class="reveal">
        <p class="eyebrow mb-5">Visie</p>
        <h2 class="text-[1.75rem] leading-snug !text-off-white sm:text-[2rem]">Waar wij naartoe werken</h2>
        <p class="mt-5 text-lg leading-relaxed text-on-dark-muted">
          Wij bouwen vanuit Suriname een professioneel outsourcingbedrijf op dat langdurige samenwerkingen aangaat met
          Nederlandse kantoren en mkb-bedrijven: met een vakkundig team, gestructureerde werkprocessen en kwaliteit die kantoren
          blijvend kunnen vertrouwen.
        </p>
      </div>
    </div>
  </section>

  {showOwner && (
  <section class="section bg-warm-cream" aria-labelledby="eigenaar-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <figure class="reveal relative mx-auto w-full max-w-md">
        <Picture
          src={ownerPhoto!}
          alt={`${owner.name}, ${owner.role.toLowerCase()} van ${site.name}`}
          formats={['avif', 'webp']}
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 28rem, 100vw"
          class="aspect-[3/4] w-full object-cover"
        />
        <span aria-hidden="true" class="absolute -top-3 -right-3 size-24 border-t border-r border-muted-copper"></span>
        <figcaption class="mt-4 text-sm text-muted">{owner.name} · {owner.role}</figcaption>
      </figure>
      <div>
        <SectionHeading id="eigenaar-title" eyebrow="De eigenaar" title={owner.name} />
        <p class="reveal mt-2 font-medium text-burgundy">{owner.role} · {owner.education}</p>
        <p class="reveal mt-6 text-lg leading-relaxed text-muted">
          {site.name} is in juni 2025 opgericht door {owner.name}. Als eigenaar en Finance Controller is hij het vaste
          aanspreekpunt voor de kantoren waarmee wij samenwerken en bewaakt hij de kwaliteit van het werk.
        </p>
        <ul class="reveal mt-7 divide-y divide-line border-y border-line">
          {experience.map((item) => (
            <li class="flex items-start gap-4 py-3.5">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-burgundy text-warm-cream"><Icon name="check" class="size-3.5" stroke={2.5} /></span>
              <span class="text-lg text-charcoal">{item}</span>
            </li>
          ))}
        </ul>
        <blockquote class="reveal mt-9 border-l-2 border-muted-copper pl-6">
          <p class="font-display text-[1.6rem] leading-snug text-charcoal italic sm:text-[1.875rem]">“{owner.quote}”</p>
          <footer class="mt-3 text-sm font-medium text-muted">— {owner.name}</footer>
        </blockquote>
      </div>
    </div>
  </section>
  )}

  <section class="section bg-off-white" aria-labelledby="waarden-title">
    <div class="container-site">
      <SectionHeading id="waarden-title" eyebrow="Onze kernwaarden" title="Hoe wij samenwerken" />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {values.map((v, i) => (
          <li class="reveal border-t-2 border-charcoal pt-6">
            <span class="font-display text-sm text-burgundy">0{i + 1}</span>
            <h3 class="mt-3 text-xl">{v.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-warm-cream" aria-labelledby="usp-title">
    <div class="container-site">
      <SectionHeading id="usp-title" eyebrow="Onderscheidend vermogen" title="Waarom kantoren met ons samenwerken" />
      <ul class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((r) => (
          <li class="reveal">
            <Icon name={r.icon} class="size-7 text-burgundy" stroke={1.3} />
            <h3 class="mt-4 text-xl">{r.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    eyebrow="Kennismaken"
    title="Bespreek uw capaciteitsbehoefte."
    text="Vertel ons over uw kantoor. Wij denken graag mee over de werkzaamheden die u kunt uitbesteden."
    primary={{ label: 'Plan een kennismakingsgesprek', href: contactHref() }}
  />
</BaseLayout>
