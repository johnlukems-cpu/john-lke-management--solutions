---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Photo from '@/components/Photo.astro';
import Logo from '@/components/Logo.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaBand from '@/components/CtaBand.astro';
import { reasons } from '@/data/content';
import { services, servicePath } from '@/data/services';
import { breadcrumbSchema } from '@/lib/schema';
import { Picture } from 'astro:assets';
import { site } from '@/config/site';
import ownerPhoto from '@/assets/team/jagernath-john.webp';

const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [{ name: 'Over ons', path: '/over-ons' }];
---

<BaseLayout
  title="Over ons"
  description="John-Luke Finance & Advies is een administratieve dienstverlener voor kleine en middelgrote ondernemingen in Suriname. Persoonlijk, zorgvuldig en met heldere afspraken."
  schema={[breadcrumbSchema(origin, crumbs)]}
>
  <PageHero
    eyebrow="Over ons"
    title="Een partner die met u meedenkt"
    intro="John-Luke Finance & Advies verzorgt de financiële administratie van kleine en middelgrote ondernemingen in Suriname, zodat ondernemers zich kunnen richten op waar zij goed in zijn."
    crumbs={crumbs}
  />

  <section class="section bg-paper" aria-labelledby="missie-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading id="missie-title" eyebrow="Waar wij voor staan" title="Uw financiële administratie. Onze zorg." />
        <div class="reveal mt-6 space-y-4 text-lg leading-relaxed text-muted">
          <p>
            Een goede administratie geeft rust en overzicht. U weet waar uw onderneming staat, uw personeel
            wordt correct betaald en uw verplichtingen zijn op tijd voorbereid.
          </p>
          <p>
            Wij nemen dat werk van u over met zorg, nauwkeurigheid en betrokkenheid. Wij werken met heldere
            afspraken en leggen in begrijpelijke taal uit wat uw cijfers betekenen. Zo houdt u grip op uw
            administratie en ruimte om te groeien.
          </p>
        </div>
      </div>
      <Photo slot="intro" class="reveal aspect-[4/3]" />
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="eigenaar-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <figure class="reveal relative mx-auto w-full max-w-md">
        <Picture
          src={ownerPhoto}
          alt={`${site.owner.name}, ${site.owner.role.toLowerCase()} van ${site.name}`}
          formats={['avif', 'webp']}
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 28rem, 100vw"
          class="aspect-[3/4] w-full object-cover"
        />
        <span aria-hidden="true" class="absolute -top-3 -right-3 size-24 border-t border-r border-gold"></span>
        <figcaption class="mt-4 text-sm text-muted">{site.owner.name} · {site.owner.role}</figcaption>
      </figure>
      <div>
        <SectionHeading id="eigenaar-title" eyebrow="De eigenaar" title={site.owner.name} />
        <p class="reveal mt-2 font-medium text-gold-deep">{site.owner.role}</p>
        <div class="reveal mt-6 space-y-4 text-lg leading-relaxed text-muted">
          <p>
            {site.name} is in juni 2025 opgericht door {site.owner.name}. Als eigenaar en Finance Controller is hij
            uw vaste aanspreekpunt en houdt hij persoonlijk toezicht op de kwaliteit van het werk.
          </p>
        </div>
        <ul class="reveal mt-7 divide-y divide-line border-y border-line">
          {[site.owner.experience, site.owner.education, 'Opgericht in juni 2025'].map((item) => (
            <li class="flex items-start gap-4 py-3.5">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-ink text-gold-light"><Icon name="check" class="size-3.5" stroke={2.5} /></span>
              <span class="text-lg text-ink">{item}</span>
            </li>
          ))}
        </ul>
        <blockquote class="reveal mt-9 border-l-2 border-gold pl-6">
          <p class="font-display text-[1.6rem] leading-snug text-ink italic sm:text-[1.875rem]">“{site.owner.quote}”</p>
          <footer class="mt-3 text-sm font-medium text-muted">— {site.owner.name}</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="logo-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="reveal flex justify-center border border-line bg-paper p-10 lg:p-14">
        <Logo height={190} heightLg={240} link={false} />
      </div>
      <div>
        <SectionHeading
          id="logo-title"
          eyebrow="De handdruk"
          title="Samenwerking op basis van vertrouwen"
          intro="De handdruk in ons logo staat voor de manier waarop wij werken: als partner naast de ondernemer. Afspraken die wij maken, komen wij na."
        />
        <ul class="reveal mt-8 grid gap-4 sm:grid-cols-2">
          {services.map((s) => (
            <li>
              <a href={servicePath(s)} class="flex items-center gap-3 border border-line bg-paper p-4 font-medium text-ink transition-colors hover:border-ink">
                <Icon name={s.icon} class="size-5 text-gold-deep" />{s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="waarden-title">
    <div class="container-site">
      <SectionHeading id="waarden-title" eyebrow="Onze uitgangspunten" title="Hoe wij werken" />
      <ul class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((r) => (
          <li class="reveal">
            <Icon name={r.icon} class="size-7 text-gold-deep" stroke={1.3} />
            <h3 class="mt-4 text-xl">{r.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
