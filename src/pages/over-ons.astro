---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Photo from '@/components/Photo.astro';
import Logo from '@/components/Logo.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaBand from '@/components/CtaBand.astro';
import { reasons } from '@/data/content';
import { services, servicePath } from '@/data/services';
import { breadcrumbSchema } from '@/lib/schema';

const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [{ name: 'Over ons', path: '/over-ons' }];
---

<BaseLayout
  title="Over ons"
  description="John-Luke Management Solutions is een administratieve dienstverlener voor kleine en middelgrote ondernemingen in Suriname. Persoonlijk, zorgvuldig en met heldere afspraken."
  schema={[breadcrumbSchema(origin, crumbs)]}
>
  <PageHero
    eyebrow="Over ons"
    title="Een partner die met u meedenkt"
    intro="John-Luke Management Solutions verzorgt de financiële administratie van kleine en middelgrote ondernemingen in Suriname, zodat ondernemers zich kunnen richten op waar zij goed in zijn."
    crumbs={crumbs}
  />

  <section class="section bg-paper" aria-labelledby="missie-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading id="missie-title" eyebrow="Waar wij voor staan" title="Uw financiële administratie. Onze zorg." />
        <div class="reveal mt-6 space-y-4 text-lg leading-relaxed text-muted">
          <p>
            Een goede administratie geeft rust en overzicht. U weet waar uw onderneming staat, uw personeel
            wordt correct betaald en uw verplichtingen zijn op tijd voorbereid.
          </p>
          <p>
            Wij nemen dat werk van u over met zorg, nauwkeurigheid en betrokkenheid. Wij werken met heldere
            afspraken en leggen in begrijpelijke taal uit wat uw cijfers betekenen. Zo houdt u grip op uw
            administratie en ruimte om te groeien.
          </p>
        </div>
      </div>
      <Photo slot="intro" class="reveal aspect-[4/3]" />
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="logo-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="reveal flex justify-center border border-line bg-paper p-10 lg:p-14">
        <Logo height={190} heightLg={240} link={false} />
      </div>
      <div>
        <SectionHeading
          id="logo-title"
          eyebrow="De handdruk"
          title="Samenwerking op basis van vertrouwen"
          intro="De handdruk in ons logo staat voor de manier waarop wij werken: als partner naast de ondernemer. Afspraken die wij maken, komen wij na."
        />
        <ul class="reveal mt-8 grid gap-4 sm:grid-cols-2">
          {services.map((s) => (
            <li>
              <a href={servicePath(s)} class="flex items-center gap-3 border border-line bg-paper p-4 font-medium text-ink transition-colors hover:border-ink">
                <Icon name={s.icon} class="size-5 text-gold-deep" />{s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="waarden-title">
    <div class="container-site">
      <SectionHeading id="waarden-title" eyebrow="Onze uitgangspunten" title="Hoe wij werken" />
      <ul class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((r) => (
          <li class="reveal">
            <Icon name={r.icon} class="size-7 text-gold-deep" stroke={1.3} />
            <h3 class="mt-4 text-xl">{r.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
