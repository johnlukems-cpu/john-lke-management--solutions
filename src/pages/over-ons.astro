---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Photo from '@/components/Photo.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaBand from '@/components/CtaBand.astro';
import { experience, reasons } from '@/data/content';
import { contactHref } from '@/data/navigation';
import { breadcrumbSchema } from '@/lib/schema';
import { Picture } from 'astro:assets';
import { site } from '@/config/site';
import ownerPhoto from '@/assets/team/jagernath-john.webp';

const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [{ name: 'Over ons', path: '/over-ons' }];
const values = [
  { title: 'Persoonlijke samenwerking', text: 'Een vast aanspreekpunt en korte lijnen met uw kantoor.' },
  { title: 'Betrouwbaarheid', text: 'Afspraken over werkzaamheden, planning en verantwoordelijkheden worden vooraf vastgelegd en nagekomen.' },
  { title: 'Nauwkeurigheid', text: 'Vaste checklists en kwaliteitscontroles bij iedere werkzaamheid.' },
  { title: 'Flexibiliteit', text: 'Capaciteit die meebeweegt met de werklast van uw kantoor.' },
];
---

<BaseLayout
  title="Over ons — Financial Outsourcing Partner vanuit Suriname"
  description="John-Luke Finance & Advies is een gespecialiseerde Financial Outsourcing Partner vanuit Paramaribo, Suriname, voor Nederlandse administratie- en accountantskantoren."
  schema={[breadcrumbSchema(origin, crumbs)]}
>
  <PageHero eyebrow="Over ons" title="Uw betrouwbare partner voor Financial Outsourcing." intro={site.tagline} crumbs={crumbs} />

  <section class="section bg-paper" aria-labelledby="wie-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading id="wie-title" eyebrow="Wie wij zijn" title="Een gespecialiseerde Financial Outsourcing Partner" />
        <div class="reveal mt-6 space-y-4 text-lg leading-relaxed text-muted">
          <p>
            John-Luke Finance &amp; Advies is een gespecialiseerde Financial Outsourcing Partner vanuit Suriname voor
            Nederlandse administratie- en accountantskantoren.
          </p>
          <p>
            Wij ondersteunen onze zakelijke partners bij financiële administratieve werkzaamheden en helpen hen hun
            capaciteit efficiënter in te zetten.
          </p>
          <p>
            Met 2,5 jaar praktijkervaring in financiële outsourcing naar Nederland combineren wij kennis van Nederlandse
            administratieve processen met moderne boekhoudsoftware en een gestructureerde werkwijze.
          </p>
        </div>
      </div>
      <Photo slot="intro" class="reveal aspect-[4/3]" />
    </div>
  </section>

  <section class="section hatch-dark on-dark bg-ink text-on-dark" aria-labelledby="missie-title">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <p class="eyebrow mb-5">Missie</p>
        <h2 id="missie-title" class="text-[1.75rem] leading-snug !text-on-dark sm:text-[2rem]">Waar wij voor staan</h2>
        <p class="mt-5 text-lg leading-relaxed text-on-dark-muted">
          Wij ondersteunen Nederlandse administratie- en accountantskantoren met betrouwbare, flexibele en kwalitatieve
          administratieve outsourcing, zodat zij hun capaciteit kunnen vergroten en hun tijd kunnen besteden aan advies,
          beoordeling en hun klanten.
        </p>
      </div>
      <div class="reveal">
        <p class="eyebrow mb-5">Visie</p>
        <h2 class="text-[1.75rem] leading-snug !text-on-dark sm:text-[2rem]">Waar wij naartoe werken</h2>
        <p class="mt-5 text-lg leading-relaxed text-on-dark-muted">
          Wij bouwen vanuit Suriname een professioneel outsourcingbedrijf op dat langdurige samenwerkingen aangaat met
          Nederlandse kantoren: met een vakkundig team, gestructureerde werkprocessen en kwaliteit die kantoren
          blijvend kunnen vertrouwen.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="eigenaar-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <figure class="reveal relative mx-auto w-full max-w-md">
        <Picture
          src={ownerPhoto}
          alt={`${site.owner.name}, ${site.owner.role.toLowerCase()} van ${site.name}`}
          formats={['avif', 'webp']}
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 28rem, 100vw"
          class="aspect-[3/4] w-full object-cover"
        />
        <span aria-hidden="true" class="absolute -top-3 -right-3 size-24 border-t border-r border-gold"></span>
        <figcaption class="mt-4 text-sm text-muted">{site.owner.name} · {site.owner.role}</figcaption>
      </figure>
      <div>
        <SectionHeading id="eigenaar-title" eyebrow="De eigenaar" title={site.owner.name} />
        <p class="reveal mt-2 font-medium text-gold-deep">{site.owner.role} · {site.owner.education}</p>
        <p class="reveal mt-6 text-lg leading-relaxed text-muted">
          {site.name} is in juni 2025 opgericht door {site.owner.name}. Als eigenaar en Finance Controller is hij het vaste
          aanspreekpunt voor de kantoren waarmee wij samenwerken en bewaakt hij de kwaliteit van het werk.
        </p>
        <ul class="reveal mt-7 divide-y divide-line border-y border-line">
          {experience.map((item) => (
            <li class="flex items-start gap-4 py-3.5">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-ink text-gold-light"><Icon name="check" class="size-3.5" stroke={2.5} /></span>
              <span class="text-lg text-ink">{item}</span>
            </li>
          ))}
        </ul>
        <blockquote class="reveal mt-9 border-l-2 border-gold pl-6">
          <p class="font-display text-[1.6rem] leading-snug text-ink italic sm:text-[1.875rem]">“{site.owner.quote}”</p>
          <footer class="mt-3 text-sm font-medium text-muted">— {site.owner.name}</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="waarden-title">
    <div class="container-site">
      <SectionHeading id="waarden-title" eyebrow="Onze kernwaarden" title="Hoe wij samenwerken" />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v, i) => (
          <li class="reveal border-t-2 border-ink pt-6">
            <span class="font-display text-sm text-gold-deep">0{i + 1}</span>
            <h3 class="mt-3 text-xl">{v.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="usp-title">
    <div class="container-site">
      <SectionHeading id="usp-title" eyebrow="Onderscheidend vermogen" title="Waarom kantoren met ons samenwerken" />
      <ul class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((r) => (
          <li class="reveal">
            <Icon name={r.icon} class="size-7 text-gold-deep" stroke={1.3} />
            <h3 class="mt-4 text-xl">{r.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    eyebrow="Kennismaken"
    title="Bespreek uw outsourcingmogelijkheden."
    text="Vertel ons over uw kantoor. Wij denken graag mee over de werkzaamheden die u kunt uitbesteden."
    primary={{ label: 'Plan een kennismakingsgesprek', href: contactHref() }}
  />
</BaseLayout>
