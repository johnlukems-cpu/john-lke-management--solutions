---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { services, servicePath } from '@/data/services';
import { coreSoftware, softwarePath } from '@/data/software';
import { contactHref } from '@/data/navigation';
import { breadcrumbSchema, countryServiceSchema, faqSchema } from '@/lib/schema';

const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [{ name: 'Nederland', path: '/nederland' }];
const cta = contactHref(undefined, 'nederland');
const description =
  'Administratieve ondersteuning voor Nederlandse administratie- en accountantskantoren: facturen, bank, btw-voorbereiding en afsluitingen in uw eigen software.';

const processes = [
  { icon: 'ledger' as const, title: 'Inkoop, verkoop en bank', text: 'Verwerking van inkoop- en verkoopfacturen en bankmutaties, coderen volgens uw rekeningschema en afletteren van openstaande posten.' },
  { icon: 'tax' as const, title: 'Voorbereiding btw-aangifte', text: 'Controle van btw-coderingen — inclusief verlegde btw, intracommunautaire en buitenlandse transacties — en aansluiting van de aangifterubrieken op het grootboek. Uw kantoor beoordeelt en dient in.' },
  { icon: 'report' as const, title: 'Periodeafsluitingen', text: 'Maand- en kwartaalafsluitingen volgens uw afsluitkalender, en voorbereiding van het jaarwerk met specificaties en aansluitingen.' },
  { icon: 'shield' as const, title: 'Controle en signalering', text: 'Bankaansluitingen, tussenrekeningen en dubbele facturen. Ongebruikelijke posten melden wij direct aan uw kantoor, dat de eigen Wwft-verplichtingen houdt.' },
];

const faq = [
  { question: 'Voor welke Nederlandse kantoren werken jullie?', answer: 'Voor administratiekantoren, boekhoudkantoren, accountantskantoren en financiële dienstverleners die financiële verwerking structureel of tijdelijk willen uitbesteden — bijvoorbeeld bij een openstaande vacature, groei of een achterstand.' },
  { question: 'Hoe zit het met de tijdzone?', answer: 'Suriname loopt in de winter 4 uur en in de zomer 5 uur achter op Nederland. Onze werkdag overlapt met de Nederlandse middag, en werk dat u aan het eind van de dag aanlevert, kan de volgende ochtend verwerkt klaarstaan.' },
  { question: 'Wie dient de btw-aangifte in?', answer: 'Uw kantoor. Wij bereiden de gegevens voor en sluiten ze aan; de fiscale beoordeling en de indiening blijven bij u.' },
  { question: 'Hoe beschermen jullie de gegevens van onze klanten?', answer: 'Wij werken uitsluitend in uw systemen, met persoonlijke accounts, tweestapsverificatie en minimale rechten. Vóór de start leggen wij een verwerkersovereenkomst vast, met afspraken over doorgifte van persoonsgegevens buiten de EER.' },
];
---

<BaseLayout
  title="Financiële administratie uitbesteden Nederland | John-Luke"
  rawTitle
  description={description}
  schema={[countryServiceSchema(origin, '/nederland', 'Nederland', description), breadcrumbSchema(origin, crumbs), faqSchema(faq)]}
>
  <PageHero
    eyebrow="Nederland"
    title="Financiële administratie outsourcing voor Nederlandse administratiekantoren."
    intro="Meer verwerkingscapaciteit voor uw kantoor, zonder wervingstraject. Wij verwerken en controleren financiële administraties in uw eigen software, volgens Nederlandse werkwijzen en uw instructies."
    crumbs={crumbs}
  >
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={cta} class="btn btn-gold">Plan een kennismakingsgesprek <Icon name="arrowRight" class="size-4" /></a>
      <a href="/diensten" class="btn btn-outline-light">Bekijk onze diensten</a>
    </div>
  </PageHero>

  <section class="section bg-paper" aria-labelledby="context-title">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-20">
      <SectionHeading
        id="context-title"
        eyebrow="De Nederlandse praktijk"
        title="Meer administraties dan handen"
        intro="In veel Nederlandse kantoren blijven vacatures lang openstaan, terwijl het aantal administraties gelijk blijft of groeit. Verwerkingswerk schuift dan door en gaat ten koste van controle, advies en klantcontact."
      />
      <div class="reveal space-y-5 text-lg leading-relaxed text-muted">
        <p>
          Uit de NOAB-benchmark Kantoorcijfers 2025 blijkt dat bij een gemiddeld administratiekantoor meer dan 12% van de
          functies openstaat, gemiddeld zo'n zes maanden lang. Personeelstekort is volgens de NOAB ook de belangrijkste reden
          waarom kantoren werk uitbesteden.
        </p>
        <p>
          Wij nemen het terugkerende verwerkings- en controlewerk over, in het Nederlands en met kennis van Nederlandse
          administratieve processen. Uw team houdt tijd over voor beoordeling en advies.
        </p>
        <p class="text-sm">Bron: NOAB, Benchmark Kantoorcijfers 2025; NOAB-enquête uitbesteding, juli 2026.</p>
      </div>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="proces-title">
    <div class="container-site">
      <SectionHeading id="proces-title" eyebrow="Werkzaamheden" title="Nederlandse administratieve processen die wij ondersteunen" />
      <ul class="mt-12 grid gap-6 md:grid-cols-2">
        {processes.map((p) => (
          <li class="reveal flex flex-col gap-4 border border-line bg-paper p-6 sm:flex-row sm:gap-5 sm:p-7">
            <span class="inline-flex size-12 shrink-0 items-center justify-center bg-ink text-gold-light"><Icon name={p.icon} class="size-6" /></span>
            <div class="min-w-0">
              <h3 class="text-xl [hyphens:auto]">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="software-title">
    <div class="container-site">
      <SectionHeading id="software-title" eyebrow="Software" title="In de pakketten van Nederlandse kantoren" intro="Wij werken in de administraties die u ons toewijst — met persoonlijke accounts en alleen de rechten die nodig zijn." />
      <ul class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {coreSoftware.map((sw) => (
          <li class="bg-paper">
            <a href={softwarePath(sw)} class="group flex h-full flex-col p-6 transition-colors hover:bg-mist">
              <span class="font-display text-xl text-ink">{sw.name}</span>
              {sw.badge && <span class="mt-1 text-xs font-semibold text-gold-deep">{sw.badge}</span>}
              <span class="mt-2 flex-1 text-sm text-muted">{sw.tasks.slice(0, 2).join(' · ')}</span>
              <span class="link-arrow mt-4 self-start">Meer informatie <Icon name="arrowRight" class="size-4" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="diensten-title">
    <div class="container-site">
      <SectionHeading id="diensten-title" eyebrow="Diensten" title="Onze diensten voor Nederlandse kantoren" />
      <ul class="mt-10 grid gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <li class="reveal">
            <a href={servicePath(s)} class="group flex items-start gap-3 border-b border-line pb-4">
              <Icon name={s.icon} class="mt-0.5 size-6 shrink-0 text-gold-deep" stroke={1.4} />
              <span>
                <span class="block font-semibold text-ink group-hover:underline">{s.name}</span>
                <span class="mt-1 block text-sm text-muted">{s.subtitle}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="faq-title">
    <div class="container-site grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <SectionHeading id="faq-title" eyebrow="Vragen" title="Veelgestelde vragen van Nederlandse kantoren" />
        <a href="/gegevensbescherming" class="link-arrow reveal mt-8">Hoe wij met uw gegevens omgaan <Icon name="arrowRight" class="size-4" /></a>
      </div>
      <FaqList items={faq} />
    </div>
  </section>

  <CtaBand
    eyebrow="Nederland"
    title="Bespreek uw capaciteitsbehoefte."
    text="Vertel ons over uw kantoor, uw software en de werkzaamheden die u wilt uitbesteden. Wij plannen een vrijblijvend kennismakingsgesprek."
    primary={{ label: 'Plan een kennismakingsgesprek', href: cta }}
    secondary={{ label: 'Bekijk onze softwarekennis', href: '/software' }}
  />
</BaseLayout>
