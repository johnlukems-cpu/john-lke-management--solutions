---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { generalFaq } from '@/data/content';
import { services, servicePath } from '@/data/services';
import { breadcrumbSchema, faqSchema } from '@/lib/schema';

const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [{ name: 'Veelgestelde vragen', path: '/veelgestelde-vragen' }];
const groups = [
  { id: 'algemeen', title: 'Algemeen', items: generalFaq },
  ...services.map((s) => ({ id: s.slug, title: s.name, items: s.faq, href: servicePath(s) })),
];
---

<BaseLayout
  title="Veelgestelde vragen"
  description="Antwoorden op veelgestelde vragen over administratie, payroll, belastingaangifte en jaarrekening bij John-Luke Management Solutions in Suriname."
  schema={[breadcrumbSchema(origin, crumbs), faqSchema(groups.flatMap((g) => g.items))]}
>
  <PageHero eyebrow="Vragen" title="Veelgestelde vragen" intro="Over samenwerken, tarieven en onze vier diensten. Staat uw vraag er niet tussen? Neem gerust contact met ons op." crumbs={crumbs} />

  <section class="section bg-paper">
    <div class="container-site grid gap-12 lg:grid-cols-[0.3fr_1fr] lg:gap-16">
      <nav aria-label="Onderwerpen" class="hidden lg:block">
        <ul class="sticky top-32 space-y-1 border-l border-line">
          {groups.map((g) => (
            <li><a href={`#${g.id}`} class="-ml-px block border-l border-transparent py-2 pl-5 text-muted hover:border-gold hover:text-ink">{g.title}</a></li>
          ))}
        </ul>
      </nav>
      <div class="space-y-16">
        {groups.map((g) => (
          <section id={g.id} aria-labelledby={`${g.id}-title`}>
            <h2 id={`${g.id}-title`} class="reveal mb-6 text-[1.75rem] sm:text-[2rem]">{g.title}</h2>
            <FaqList items={g.items} />
            {'href' in g && g.href && <a href={g.href} class="link-arrow mt-6">Lees meer over {g.title}</a>}
          </section>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Nog een vraag?" text="Neem contact op of plan een vrijblijvende kennismaking. Wij denken graag met u mee." />
</BaseLayout>
