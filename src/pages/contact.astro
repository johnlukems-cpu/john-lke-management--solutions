---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactSection from '@/components/ContactSection.astro';
import { breadcrumbSchema } from '@/lib/schema';

const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [{ name: 'Contact', path: '/contact' }];
---

<BaseLayout
  title="Contact en kennismaking"
  description="Neem contact op met John-Luke Management Solutions via WhatsApp, e-mail of het contactformulier, of plan een vrijblijvende kennismaking. Voor ondernemers in Suriname."
  schema={[breadcrumbSchema(origin, crumbs)]}
>
  <PageHero eyebrow="Contact" title="Plan een kennismaking" intro="Vertel ons over uw onderneming. In een vrijblijvend gesprek bespreken wij hoe wij u kunnen ondersteunen met administratie, payroll, tax of jaarrekening." crumbs={crumbs} />
  <ContactSection tone="paper" title="Zo bereikt u ons" />
</BaseLayout>
