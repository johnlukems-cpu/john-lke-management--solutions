---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactSection from '@/components/ContactSection.astro';
import { breadcrumbSchema } from '@/lib/schema';

const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [{ name: 'Contact', path: '/contact' }];
---

<BaseLayout
  title="Contact — bespreek uw outsourcingmogelijkheden"
  description="Neem contact op met John-Luke Finance Outsourcing voor financial outsourcing voor uw administratie- of accountantskantoor. Plan een kennismakingsgesprek of vraag outsourcing aan."
  schema={[breadcrumbSchema(origin, crumbs)]}
>
  <PageHero
    eyebrow="Contact"
    title="Bespreek uw outsourcingmogelijkheden."
    intro="Vertel ons over uw kantoor, de administraties en de werkzaamheden die u wilt uitbesteden. Wij nemen binnen één werkdag contact met u op voor een kennismakingsgesprek."
    crumbs={crumbs}
  />
  <ContactSection tone="paper" eyebrow="Outsourcing aanvragen" title="Vraag outsourcing aan" />
</BaseLayout>
