---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactSection from '@/components/ContactSection.astro';
import { breadcrumbSchema } from '@/lib/schema';

const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [{ name: 'Contact', path: '/contact' }];
---

<BaseLayout
  title="Contact — plan een kennismakingsgesprek | John-Luke"
  rawTitle
  description="Plan een kennismakingsgesprek over extra capaciteit voor de financiële administratie van uw kantoor in Nederland. Reactie binnen één werkdag."
  schema={[breadcrumbSchema(origin, crumbs)]}
>
  <PageHero
    eyebrow="Contact"
    title="Plan een kennismakingsgesprek."
    intro="Vertel ons over uw kantoor, uw software en de ondersteuning die u zoekt. Wij nemen binnen één werkdag contact met u op om een gesprek in te plannen — online, op een moment dat u past."
    crumbs={crumbs}
  />
  <ContactSection tone="paper" eyebrow="Uw aanvraag" title="Bespreek uw capaciteitsbehoefte" intro="Hoe meer wij vooraf weten over uw kantoor en werkzaamheden, hoe gerichter het eerste gesprek. Alleen de velden met een sterretje zijn verplicht." />
</BaseLayout>
