---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { coreSoftware, softwarePath, softwareScope, type CoreSoftware } from '@/data/software';
import { serviceBySlug, servicePath } from '@/data/services';
import { contactHref } from '@/data/navigation';
import { breadcrumbSchema, faqSchema, softwareServiceSchema } from '@/lib/schema';

export const getStaticPaths = (() =>
  coreSoftware.map((sw) => ({ params: { slug: sw.slug }, props: { sw } }))) satisfies GetStaticPaths;

interface Props {
  sw: CoreSoftware;
}
const { sw } = Astro.props;
const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [
  { name: 'Software', path: '/software' },
  { name: sw.name, path: softwarePath(sw) },
];
const related = sw.services.map(serviceBySlug).filter((s) => s !== undefined);
const others = coreSoftware.filter((s) => s.slug !== sw.slug);
const cta = contactHref();
---

<BaseLayout
  title={sw.seoTitle}
  rawTitle
  description={sw.seoDescription}
  schema={[softwareServiceSchema(origin, sw), breadcrumbSchema(origin, crumbs), faqSchema(sw.faq)]}
>
  <PageHero eyebrow={`Software · ${sw.type}`} title={sw.heading} intro={sw.intro[0]} crumbs={crumbs}>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a href={cta} class="btn btn-gold">Plan een kennismakingsgesprek <Icon name="arrowRight" class="size-4" /></a>
      <a href="/diensten" class="btn btn-outline-light">Bekijk onze diensten</a>
    </div>
  </PageHero>

  <section class="section bg-paper" aria-labelledby="werk-title">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading id="werk-title" eyebrow={sw.name} title={`Wat wij in ${sw.name} verwerken`} />
        <div class="reveal mt-6 space-y-4 text-lg leading-relaxed text-muted">
          {sw.intro.slice(1).map((p) => <p>{p}</p>)}
        </div>
        <p class="reveal mt-8 border-l-2 border-gold bg-mist p-5 text-[0.9375rem] leading-relaxed text-muted">{softwareScope}</p>
      </div>
      <div class="grid gap-8">
        <div class="reveal">
          <h3 class="font-sans text-sm font-semibold tracking-wide text-ink uppercase">Werkprocessen</h3>
          <ul class="mt-4 divide-y divide-line border-y border-line">
            {sw.workflows.map((w) => (
              <li class="flex items-start gap-4 py-3">
                <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-ink text-gold-light"><Icon name="check" class="size-3.5" stroke={2.5} /></span>
                <span class="text-ink">{w}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal">
          <h3 class="font-sans text-sm font-semibold tracking-wide text-ink uppercase">Vormen van ondersteuning</h3>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {sw.support.map((t) => <li class="flex items-start gap-3 text-muted"><Icon name="arrowRight" class="mt-1 size-4 shrink-0 text-gold-deep" /><span class="min-w-0">{t}</span></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="voordelen-title">
    <div class="container-site">
      <SectionHeading id="voordelen-title" eyebrow="Voor uw kantoor" title={`Voordelen van uitbesteden in ${sw.name}`} />
      <ul class="mt-12 grid gap-6 lg:grid-cols-3">
        {sw.benefits.map((b, i) => (
          <li class="reveal border-t-2 border-ink bg-paper p-7">
            <span class="font-display text-sm text-gold-deep">0{i + 1}</span>
            <h3 class="mt-3 text-xl">{b.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{b.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="diensten-title">
    <div class="container-site">
      <SectionHeading id="diensten-title" eyebrow="Diensten" title={`Diensten in ${sw.name}`} />
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((s) => (
          <li class="reveal">
            <a href={servicePath(s)} class="group flex h-full flex-col border border-line bg-paper p-6 transition-colors hover:border-ink">
              <Icon name={s.icon} class="size-7 text-gold-deep" stroke={1.3} />
              <h3 class="mt-4 text-lg">{s.name}</h3>
              <p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-muted">{s.summary}</p>
              <span class="link-arrow mt-4 self-start">Bekijk dienst <Icon name="arrowRight" class="size-4" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="faq-title">
    <div class="container-site grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <SectionHeading id="faq-title" eyebrow="Vragen" title={`Veelgestelde vragen over ${sw.name}`} />
        <p class="reveal mt-6 text-muted">Ook ondersteuning in:</p>
        <ul class="reveal mt-3 flex flex-wrap gap-2">
          {others.map((o) => <li><a href={softwarePath(o)} class="inline-block border border-line bg-paper px-3.5 py-2 text-sm font-medium text-ink transition-colors hover:border-ink">{o.name}</a></li>)}
        </ul>
      </div>
      <FaqList items={sw.faq} />
    </div>
  </section>

  <CtaBand
    eyebrow={sw.name}
    title={`Extra capaciteit in ${sw.name}?`}
    text="Vertel ons welke administraties en werkzaamheden u wilt uitbesteden. Wij bespreken de mogelijkheden in een vrijblijvend kennismakingsgesprek."
    primary={{ label: 'Plan een kennismakingsgesprek', href: cta }}
    secondary={{ label: 'Alle software', href: '/software' }}
  />
</BaseLayout>
