---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaBand from '@/components/CtaBand.astro';
import { automation, coreSoftware, otherSoftware, softwarePath, softwareScope } from '@/data/software';
import { contactHref } from '@/data/navigation';
import { breadcrumbSchema } from '@/lib/schema';

const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [{ name: 'Software', path: '/software' }];
---

<BaseLayout
  title="Software: Nmbrs Accounting (Yuki), AFAS en Exact Online"
  rawTitle
  description="Financiële administratie uitbesteden in uw eigen software: Nmbrs Accounting (voorheen Yuki), AFAS Profit, AFAS SB en Exact Online, voor Nederlandse kantoren."
  schema={[breadcrumbSchema(origin, crumbs)]}
>
  <PageHero
    eyebrow="Software"
    title="Uw software. Onze expertise."
    intro="Wij sluiten aan op de softwareomgeving waarmee uw kantoor al werkt. Geen nieuwe systemen of extra licenties: wij werken in de administraties die u ons toewijst, met persoonlijke accounts en alleen de rechten die nodig zijn."
    crumbs={crumbs}
  >
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={contactHref()} class="btn btn-gold">Plan een kennismakingsgesprek <Icon name="arrowRight" class="size-4" /></a>
    </div>
  </PageHero>

  <section class="section bg-paper" aria-labelledby="overzicht-title">
    <div class="container-site">
      <SectionHeading
        id="overzicht-title"
        eyebrow="Specialisaties"
        title="Vier pakketten waarin wij gespecialiseerd zijn"
        intro="Per pakket ziet u welke financiële werkprocessen wij ondersteunen en wat dat uw kantoor oplevert."
      />
      <ul class="mt-12 grid gap-6 md:grid-cols-2">
        {coreSoftware.map((s) => (
          <li class="reveal flex flex-col border border-line bg-paper p-7 lg:p-8">
            <div class="flex flex-wrap items-center gap-3">
              <p class="text-sm font-medium text-gold-deep">{s.type}</p>
              {s.badge && <span class="border border-gold px-2 py-0.5 text-xs font-semibold text-gold-deep">{s.badge}</span>}
            </div>
            <h2 class="mt-2 text-[1.75rem]">{s.name}</h2>
            <p class="mt-3 leading-relaxed text-muted">{s.usedFor}</p>
            <h3 class="mt-6 font-sans text-sm font-semibold text-ink">Wat wij ermee ondersteunen</h3>
            <ul class="mt-3 grid gap-2 sm:grid-cols-2">
              {s.tasks.map((t) => <li class="flex items-start gap-3 text-ink"><Icon name="check" class="mt-1 size-4 shrink-0 text-gold-deep" stroke={2.2} />{t}</li>)}
            </ul>
            <p class="mt-6 flex-1 border-l-2 border-gold pl-4 text-[0.9375rem] leading-relaxed text-muted"><span class="font-semibold text-ink">Voor uw kantoor: </span>{s.helps}</p>
            <a href={softwarePath(s)} class="link-arrow mt-6 self-start">Meer over {s.name} <Icon name="arrowRight" class="size-4" /></a>
          </li>
        ))}
      </ul>
      <p class="reveal mt-8 max-w-3xl text-sm leading-relaxed text-muted">{softwareScope}</p>

      <div class="reveal mt-14 border-t border-line pt-10">
        <h2 class="text-2xl">Ook bekend met</h2>
        <p class="mt-2 max-w-2xl text-muted">Werkt een deel van uw administraties in een ander pakket? Ook daarin kunnen wij de verwerking verzorgen.</p>
        <ul class="mt-6 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
          {otherSoftware.map((s) => (
            <li class="bg-paper p-5">
              <span class="block font-semibold text-ink">{s.name}</span>
              <span class="mt-1 block text-sm text-muted">{s.type}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm leading-relaxed text-muted">Claude AI is een product van Anthropic. Wij hebben er praktische kennis van en zijn geen partner van Anthropic.</p>
      </div>
    </div>
  </section>

  <section id="automatisering" class="section hatch-dark on-dark scroll-mt-24 bg-ink text-on-dark" aria-labelledby="auto-title">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading id="auto-title" eyebrow="Automatisering en AI" title="Slimmer werken met automatisering en Claude AI" intro={automation.intro} onDark />
        <p class="reveal mt-6 border-l-2 border-gold pl-5 leading-relaxed text-on-dark-muted">{automation.safeguards}</p>
      </div>
      <ul class="reveal space-y-4 self-center">
        {automation.items.map((t) => (
          <li class="flex items-start gap-4 border-b border-white/10 pb-4 last:border-0">
            <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-gold text-ink"><Icon name="check" class="size-3.5" stroke={2.5} /></span>
            <span class="text-lg text-on-dark">{t}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="hoe-title">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-20">
      <SectionHeading id="hoe-title" eyebrow="Zo werkt het" title="Veilig werken in uw omgeving" />
      <ul class="reveal space-y-5">
        {[
          ['Eigen, persoonlijke accounts', 'U maakt voor ons persoonlijke gebruikers aan, met alleen de rechten die nodig zijn. Nooit gedeelde inloggegevens.'],
          ['Tweestapsverificatie', 'Wij werken waar mogelijk met multifactor-authenticatie op alle systemen.'],
          ['Uw instructies en rekeningschema', 'Wij volgen uw werkinstructies, coderingen en controles; twijfelgevallen stemmen wij af.'],
          ['Toegang intrekken wanneer u wilt', 'U houdt volledige controle over de toegang tot uw systemen en administraties.'],
        ].map(([t, d]) => (
          <li class="flex gap-4 border-b border-line pb-5 last:border-0">
            <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-ink text-gold-light"><Icon name="check" class="size-3.5" stroke={2.5} /></span>
            <span><span class="block font-semibold text-ink">{t}</span><span class="mt-1 block text-muted">{d}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    eyebrow="Software"
    title="Werkt uw kantoor met een van deze pakketten?"
    text="Bespreek welke administraties en werkzaamheden u wilt uitbesteden. Wij starten graag met een pilot in uw eigen omgeving."
    primary={{ label: 'Plan een kennismakingsgesprek', href: contactHref() }}
    secondary={{ label: 'Bekijk onze diensten', href: '/diensten' }}
  />
</BaseLayout>
