---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Logo from '@/components/Logo.astro';
import Photo from '@/components/Photo.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import NewsCard from '@/components/NewsCard.astro';
import { Picture } from 'astro:assets';
import { services } from '@/data/services';
import { software } from '@/data/software';
import { experience, generalFaq, reasons, steps } from '@/data/content';
import { contactHref } from '@/data/navigation';
import { faqSchema } from '@/lib/schema';
import { getNews } from '@/lib/news';
import { site } from '@/config/site';
import ownerPhoto from '@/assets/team/jagernath-john.webp';

const latestNews = (await getNews()).slice(0, 1);
const pains = [
  { icon: 'users' as const, title: 'Personeelstekort', text: 'Vacatures blijven open staan, terwijl het aantal administraties gelijk blijft of groeit.' },
  { icon: 'calendar' as const, title: 'Pieken rond deadlines', text: 'Btw-aangiften en het jaarwerk vragen capaciteit op precies dezelfde momenten.' },
  { icon: 'layers' as const, title: 'Achterstanden', text: 'Verwerkingswerk schuift door en gaat ten koste van controle en advies.' },
];
---

<BaseLayout
  title="Financial Outsourcing voor administratie- en accountantskantoren | John-Luke Finance Outsourcing"
  rawTitle
  description="Financial outsourcing voor Nederlandse administratie- en accountantskantoren: financiële administratie, btw-administratie en backoffice-ondersteuning op afstand vanuit Suriname. Plan een kennismakingsgesprek."
  schema={[faqSchema(generalFaq)]}
>
  <!-- 1. HERO -->
  <section class="relative overflow-hidden bg-paper">
    <div aria-hidden="true" class="absolute inset-y-0 right-0 hidden w-[38%] bg-mist lg:block"></div>
    <div class="container-site relative grid items-center gap-12 py-12 md:py-16 lg:grid-cols-[1.08fr_0.92fr] lg:gap-16 lg:py-24">
      <div class="reveal min-w-0">
        <p class="eyebrow mb-6">{site.tagline}</p>
        <h1 class="text-[1.625rem] leading-[1.12] min-[400px]:text-[2rem] sm:text-[3rem] lg:text-[3.5rem] lg:leading-[1.08]">
          Financial Outsourcing voor Nederlandse <span class="italic text-gold-deep">administratie- en accountantskantoren</span>.
        </h1>
        <p class="mt-6 text-xl font-medium text-ink">Vergroot uw capaciteit met professionele financiële ondersteuning vanuit Suriname.</p>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
          John-Luke Finance Outsourcing ondersteunt Nederlandse administratie- en accountantskantoren bij het verwerken
          en controleren van financiële administraties. Met praktijkervaring in Nederlandse administraties en kennis van
          verschillende boekhoudsystemen bieden wij flexibele ondersteuning op afstand.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={contactHref()} class="btn btn-primary">Plan een kennismakingsgesprek <Icon name="arrowRight" class="size-4" /></a>
          <a href="#diensten" class="btn btn-outline">Bekijk onze diensten</a>
        </div>
        <ul class="mt-10 grid gap-3 border-t border-line pt-7 sm:grid-cols-3">
          {['3+ jaar Nederlandse administratie en btw', 'Administratie vanaf €12 per uur', 'Gericht op langdurige samenwerking'].map((t) => (
            <li class="flex items-start gap-2.5 text-[0.9375rem] font-medium text-ink"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-gold-deep" stroke={2} />{t}</li>
          ))}
        </ul>
      </div>

      <div class="reveal relative">
        <Photo slot="hero" class="aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5]" sizes="(min-width: 1024px) 45vw, 100vw" priority mark={false} />
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(closest-side,rgba(255,255,255,.88),rgba(255,255,255,.55)_55%,rgba(255,255,255,0))]"></div>
        <div class="absolute inset-0 grid place-items-center p-6">
          <div class="[filter:drop-shadow(0_0_2px_rgba(255,255,255,.95))_drop-shadow(0_0_10px_rgba(255,255,255,.9))]">
            <Logo height={170} heightLg={220} link={false} priority />
          </div>
        </div>
        <span aria-hidden="true" class="absolute -top-3 -right-3 hidden size-24 border-t border-r border-gold lg:block"></span>
      </div>
    </div>
  </section>

  <!-- 2. INTRODUCTIE FINANCIAL OUTSOURCING -->
  <section class="section bg-mist" aria-labelledby="intro-title">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div>
        <SectionHeading
          id="intro-title"
          eyebrow="Financial Outsourcing"
          title="Meer capaciteit, zonder extra vaste formatie"
          intro="Veel Nederlandse kantoren hebben meer werk dan handen. Financial outsourcing geeft u extra capaciteit voor terugkerend verwerkings- en controlewerk, zodat uw eigen team zich kan richten op beoordeling, advies en klantcontact."
        />
        <p class="reveal mt-6 text-lg leading-relaxed text-muted">
          Wij werken in uw software, volgens uw werkinstructies en met vaste kwaliteitscontroles. U houdt de
          regie en de eindverantwoordelijkheid; wij leveren betrouwbare, flexibele capaciteit. Wij bouwen op
          langdurige samenwerking: hoe beter wij uw kantoor kennen, hoe meer waarde wij toevoegen.
        </p>
      </div>
      <ul class="grid gap-4 self-center">
        {pains.map((p) => (
          <li class="reveal flex gap-5 border border-line bg-paper p-6">
            <span class="inline-flex size-12 shrink-0 items-center justify-center bg-ink text-gold-light"><Icon name={p.icon} class="size-6" /></span>
            <div>
              <h3 class="text-xl">{p.title}</h3>
              <p class="mt-1.5 leading-relaxed text-muted">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. DIENSTEN -->
  <section id="diensten" class="section bg-paper" aria-labelledby="diensten-title">
    <div class="container-site">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading
          id="diensten-title"
          eyebrow="Onze diensten"
          title="Wat wij voor uw kantoor kunnen verwerken"
          intro="Vier vaste diensten voor terugkerend werk, aangevuld met jaarafsluiting en backoffice-ondersteuning op aanvraag."
        />
        <a href="/diensten" class="link-arrow reveal shrink-0 self-start lg:self-end">Alle diensten <Icon name="arrowRight" class="size-4" /></a>
      </div>
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service, index) => <ServiceCard service={service} index={index} />)}
      </ul>
    </div>
  </section>

  <!-- 4. SOFTWAREKENNIS -->
  <section class="section bg-mist" aria-labelledby="software-title">
    <div class="container-site">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading
          id="software-title"
          eyebrow="Softwarekennis"
          title="Wij werken in de software van uw kantoor"
          intro="Praktijkervaring met de boek­houd- en administratiesystemen die in Nederlandse kantoren veel worden gebruikt."
        />
        <a href="/software" class="link-arrow reveal shrink-0 self-start lg:self-end">Meer over onze softwarekennis <Icon name="arrowRight" class="size-4" /></a>
      </div>
      <ul class="reveal mt-12 grid grid-cols-2 gap-px border border-line bg-line sm:grid-cols-3">
        {software.map((s) => (
          <li class="flex min-h-24 flex-col items-center justify-center bg-paper px-4 py-6 text-center">
            <span class="font-display text-xl text-ink">{s.name}</span>
            <span class="mt-1 text-xs text-muted">{s.type}</span>
          </li>
        ))}
      </ul>
      <a href="/software#automatisering" class="reveal group mt-6 flex flex-col gap-4 border border-line bg-paper p-6 transition-colors hover:border-ink sm:flex-row sm:items-center sm:justify-between">
        <span class="flex items-start gap-4">
          <span class="inline-flex size-11 shrink-0 items-center justify-center bg-ink text-gold-light"><Icon name="automation" class="size-5" /></span>
          <span>
            <span class="block font-semibold text-ink">Ook automatisering en AI</span>
            <span class="mt-1 block text-muted">Wij helpen terugkerende administratieve processen te automatiseren en hebben praktische kennis van Claude AI.</span>
          </span>
        </span>
        <span class="link-arrow shrink-0 self-start sm:self-center">Meer over automatisering <Icon name="arrowRight" class="size-4" /></span>
      </a>
    </div>
  </section>

  <!-- 5. WAAROM -->
  <section class="section hatch-dark on-dark bg-ink text-on-dark" aria-labelledby="waarom-title">
    <div class="container-site">
      <SectionHeading id="waarom-title" eyebrow="Waarom samenwerken met ons?" title="Een outsourcingpartner die uw werkwijze kent" onDark />
      <ul class="mt-14 grid gap-px overflow-hidden border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((r) => (
          <li class="reveal bg-ink p-7 lg:p-8">
            <Icon name={r.icon} class="size-7 text-gold-light" stroke={1.3} />
            <h3 class="mt-5 text-xl !text-on-dark">{r.title}</h3>
            <p class="mt-3 leading-relaxed text-on-dark-muted">{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. WERKWIJZE -->
  <section id="werkwijze" class="section bg-paper" aria-labelledby="werkwijze-title">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div>
        <SectionHeading id="werkwijze-title" eyebrow="Onze werkwijze" title="Van kennismaking tot vaste samenwerking" intro="Wij starten klein met een pilot, zodat u onze werkwijze en kwaliteit eerst kunt beoordelen." />
        <ol class="mt-10">
          {steps.map((step, i) => (
            <li class="reveal relative flex gap-6 pb-9 last:pb-0">
              {i < steps.length - 1 && <span aria-hidden="true" class="absolute top-12 bottom-0 left-[1.4rem] w-px bg-line"></span>}
              <span class="relative inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-ink bg-paper font-display text-lg text-ink">{i + 1}</span>
              <div class="pt-1.5">
                <h3 class="text-xl">{step.title}</h3>
                <p class="mt-2 leading-relaxed text-muted">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <Photo slot="werkwijze" class="reveal aspect-[4/3] self-center lg:aspect-[4/5]" />
    </div>
  </section>

  <!-- 7. OVER JOHN-LUKE -->
  <section class="section bg-mist" aria-labelledby="over-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
      <figure class="reveal relative mx-auto w-full max-w-sm">
        <Picture src={ownerPhoto} alt={`${site.owner.name}, ${site.owner.role.toLowerCase()}`} formats={['avif', 'webp']} widths={[400, 700]} sizes="(min-width: 1024px) 24rem, 100vw" class="aspect-[3/4] w-full object-cover" />
        <span aria-hidden="true" class="absolute -top-3 -right-3 size-24 border-t border-r border-gold"></span>
      </figure>
      <div>
        <SectionHeading
          id="over-title"
          eyebrow="Over John-Luke Finance Outsourcing"
          title="Een gespecialiseerde outsourcingpartner vanuit Paramaribo"
          intro={`Opgericht door ${site.owner.name} (${site.owner.role.toLowerCase()}, ${site.owner.education}). Wij combineren kennis van Nederlandse administratieve processen met moderne boekhoudsoftware en een gestructureerde werkwijze.`}
        />
        <ul class="reveal mt-7 grid gap-3 sm:grid-cols-2">
          {experience.map((e) => (
            <li class="flex items-start gap-3 text-ink"><span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-ink text-gold-light"><Icon name="check" class="size-3.5" stroke={2.5} /></span>{e}</li>
          ))}
        </ul>
        <a href="/over-ons" class="link-arrow reveal mt-9">Meer over ons <Icon name="arrowRight" class="size-4" /></a>
      </div>
    </div>
  </section>

  <!-- NIEUWS -->
  {latestNews.length > 0 && (
    <section id="nieuws" class="section bg-paper" aria-labelledby="nieuws-title">
      <div class="container-site">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <SectionHeading id="nieuws-title" eyebrow="Nieuws" title="Actueel bij John-Luke" />
          <a href="/nieuws" class="link-arrow reveal shrink-0 self-start lg:self-end">Alle nieuwsberichten <Icon name="arrowRight" class="size-4" /></a>
        </div>
        <ul class="mt-12 grid gap-8">
          {latestNews.map((entry) => <li><NewsCard entry={entry} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <!-- 8. FAQ -->
  <section id="faq" class="section bg-mist" aria-labelledby="faq-title">
    <div class="container-site grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <SectionHeading id="faq-title" eyebrow="Vragen" title="Veelgestelde vragen" intro="Over samenwerken op afstand, gegevensbescherming, verantwoordelijkheden en tarieven." />
        <a href="/veelgestelde-vragen" class="link-arrow reveal mt-8">Alle vragen bekijken <Icon name="arrowRight" class="size-4" /></a>
      </div>
      <FaqList items={generalFaq} />
    </div>
  </section>

  <!-- 9. CONTACT-CTA -->
  <CtaBand
    eyebrow="Financial Outsourcing"
    title="Bespreek uw outsourcingmogelijkheden."
    text="Vertel ons welke werkzaamheden u wilt uitbesteden. Wij maken een voorstel op maat en starten graag met een pilot."
    primary={{ label: 'Plan een kennismakingsgesprek', href: contactHref() }}
    secondary={{ label: 'Bekijk onze diensten', href: '/diensten' }}
  />
</BaseLayout>
