---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Logo from '@/components/Logo.astro';
import Photo from '@/components/Photo.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import NewsCard from '@/components/NewsCard.astro';
import { Picture } from 'astro:assets';
import { services } from '@/data/services';
import { coreSoftware, softwarePath } from '@/data/software';
import { dutchProcesses, experience, generalFaq, problems, steps, trustPoints } from '@/data/content';
import { contactHref } from '@/data/navigation';
import { faqSchema } from '@/lib/schema';
import { getNews } from '@/lib/news';
import { site } from '@/config/site';
import { owner, showOwner, getOwnerPhoto } from '@/config/owner';
const ownerPhoto = await getOwnerPhoto();

const latestNews = (await getNews()).slice(0, 1);
---

<BaseLayout
  title="Financiële administratie uitbesteden in Nederland | John-Luke"
  rawTitle
  description="Financiële administratieve outsourcing voor Nederlandse administratiekantoren, accountantskantoren en mkb-bedrijven, in Nmbrs Accounting, AFAS en Exact Online."
  schema={[faqSchema(generalFaq)]}
>
  <!-- 1. HERO -->
  <section class="relative overflow-hidden bg-paper">
    <div aria-hidden="true" class="absolute inset-y-0 right-0 hidden w-[38%] bg-mist lg:block"></div>
    <div class="container-site relative grid items-center gap-12 py-12 md:py-16 lg:grid-cols-[1.08fr_0.92fr] lg:gap-16 lg:py-24">
      <div class="reveal min-w-0">
        <p class="eyebrow mb-6">{site.tagline}</p>
        <h1 class="text-[1.75rem] leading-[1.12] min-[400px]:text-[2.125rem] sm:text-[3rem] lg:text-[2.75rem] lg:leading-[1.08] xl:text-[3.5rem]">
          Meer financiële verwerkingscapaciteit voor <span class="italic text-gold-deep">uw kantoor</span>.
        </h1>
        <p class="mt-6 text-xl font-medium text-ink">{site.positioning}</p>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
          John-Luke Finance Outsourcing ondersteunt administratiekantoren, accountantskantoren en mkb-bedrijven met
          professionele financiële administratieve verwerking. Vanuit Suriname bieden wij flexibele capaciteit, softwarekennis en persoonlijke
          kwaliteitscontrole, zodat u zich kunt blijven richten op klanten en groei.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={contactHref()} class="btn btn-primary">Plan een kennismakingsgesprek <Icon name="arrowRight" class="size-4" /></a>
          <a href="#diensten" class="btn btn-outline">Bekijk onze diensten</a>
        </div>
        <ul class="mt-10 grid gap-3 border-t border-line pt-7 sm:grid-cols-3">
          {['Voor kantoren en mkb-bedrijven', 'In Nmbrs Accounting, AFAS en Exact Online', 'Verwerking vanaf €12 per uur'].map((t) => (
            <li class="flex items-start gap-2.5 text-[0.9375rem] font-medium text-ink"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-gold-deep" stroke={2} /><span class="min-w-0">{t}</span></li>
          ))}
        </ul>
      </div>

      <div class="reveal relative">
        <Photo slot="hero" class="aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5]" sizes="(min-width: 1024px) 45vw, 100vw" priority mark={false} />
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(closest-side,rgba(255,255,255,.88),rgba(255,255,255,.55)_55%,rgba(255,255,255,0))]"></div>
        <div class="absolute inset-0 grid place-items-center p-6">
          <div class="[filter:drop-shadow(0_0_2px_rgba(255,255,255,.95))_drop-shadow(0_0_10px_rgba(255,255,255,.9))]">
            <Logo height={170} heightLg={220} link={false} priority />
          </div>
        </div>
        <span aria-hidden="true" class="absolute -top-3 -right-3 hidden size-24 border-t border-r border-gold lg:block"></span>
      </div>
    </div>
  </section>

  <!-- 2. VERTROUWEN EN WAARDE -->
  <section class="section bg-mist" aria-labelledby="waarde-title">
    <div class="container-site">
      <SectionHeading
        id="waarde-title"
        eyebrow="Waarom John-Luke"
        title="Uw betrouwbare partner in financiële administratie."
        intro="Meer financiële administratiecapaciteit, zonder de extra wervingslast. Wij werken in uw software, volgens uw werkinstructies; u houdt de regie en de eindverantwoordelijkheid."
      />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {trustPoints.map((p) => (
          <li class="reveal flex flex-col border border-line bg-paper p-7">
            <span class="inline-flex size-12 items-center justify-center bg-ink text-gold-light"><Icon name={p.icon} class="size-6" /></span>
            <h3 class="mt-5 text-xl">{p.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. PROBLEEM EN OPLOSSING -->
  <section class="section bg-paper" aria-labelledby="probleem-title">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading id="probleem-title" eyebrow="Herkenbaar?" title="Meer werk, maar niet altijd voldoende capaciteit?" />
        <ul class="reveal mt-8 grid gap-3 sm:grid-cols-2">
          {problems.map((p) => (
            <li class="flex items-center gap-3 border border-line px-4 py-3.5 text-ink">
              <Icon name={p.icon} class="size-5 shrink-0 text-gold-deep" />
              <span class="font-medium">{p.title}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal min-w-0 self-center border-l-2 border-gold bg-mist p-5 sm:p-8 lg:p-10">
        <p class="eyebrow mb-4">De oplossing</p>
        <h3 class="text-2xl sm:text-[1.75rem]">Extra capaciteit die direct in uw werkwijze past</h3>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          John-Luke Finance Outsourcing neemt het terugkerende verwerkings- en controlewerk over: facturen, bank,
          aansluitingen en de voorbereiding van afsluitingen. In uw eigen software, met vaste verwerkers en een tweede
          controle. Zonder wervingstraject en zonder extra vaste formatie.
        </p>
        <a href={contactHref()} class="btn btn-primary mt-8">Bespreek uw capaciteitsbehoefte <Icon name="arrowRight" class="size-4" /></a>
      </div>
    </div>
  </section>

  <!-- 3b. NEDERLANDSE PRAKTIJK -->
  <section class="section bg-mist" aria-labelledby="praktijk-title">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <SectionHeading
          id="praktijk-title"
          eyebrow="De Nederlandse praktijk"
          title="Afgestemd op Nederlandse administratieve processen"
          intro="Wij werken in het Nederlands, volgens uw rekeningschema en werkinstructies, en met kennis van Nederlandse btw-processen."
        />
        <div class="reveal space-y-4 text-lg leading-relaxed text-muted lg:pt-10">
          <p>
            Bij een gemiddeld administratiekantoor staat meer dan 12% van de functies open, gemiddeld zo'n zes maanden lang.
            Personeelstekort is volgens de NOAB de belangrijkste reden waarom kantoren werk uitbesteden.
          </p>
          <p class="text-sm">Bron: NOAB, Benchmark Kantoorcijfers 2025; NOAB-enquête uitbesteding, juli 2026.</p>
        </div>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-2">
        {dutchProcesses.map((p) => (
          <li class="reveal flex flex-col gap-4 border border-line bg-paper p-6 sm:flex-row sm:gap-5 sm:p-7">
            <span class="inline-flex size-12 shrink-0 items-center justify-center bg-ink text-gold-light"><Icon name={p.icon} class="size-6" /></span>
            <div class="min-w-0">
              <h3 class="text-xl">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. DIENSTEN -->
  <section id="diensten" class="section scroll-mt-24 bg-paper" aria-labelledby="diensten-title">
    <div class="container-site">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading
          id="diensten-title"
          eyebrow="Onze diensten"
          title="Wat wij voor uw kantoor verwerken"
          intro="Zes diensten, van dagelijkse verwerking tot afsluitingen en tijdelijke capaciteit. Wij bereiden voor; uw kantoor beoordeelt en accordeert."
        />
        <a href="/diensten" class="link-arrow reveal shrink-0 self-start lg:self-end">Ontdek onze diensten <Icon name="arrowRight" class="size-4" /></a>
      </div>
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service, index) => <ServiceCard service={service} index={index} />)}
      </ul>
    </div>
  </section>

  <!-- 5. SOFTWARE -->
  <section class="section bg-mist" aria-labelledby="software-title">
    <div class="container-site">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading
          id="software-title"
          eyebrow="Software"
          title="Uw software. Onze expertise."
          intro="Wij sluiten aan op de softwareomgeving waarmee uw kantoor al werkt."
        />
        <a href="/software" class="link-arrow reveal shrink-0 self-start lg:self-end">Bekijk onze softwarekennis <Icon name="arrowRight" class="size-4" /></a>
      </div>
      <ul class="reveal mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {coreSoftware.map((sw) => (
          <li class="bg-paper">
            <a href={softwarePath(sw)} class="group flex h-full flex-col p-6 transition-colors hover:bg-mist lg:p-7">
              <span class="font-display text-2xl text-ink">{sw.name}</span>
              <span class="mt-1 min-h-5 text-xs font-semibold text-gold-deep">{sw.badge ?? ''}</span>
              <span class="mt-3 flex-1 text-sm leading-relaxed text-muted">{sw.tasks.join(' · ')}</span>
              <span class="link-arrow mt-5 self-start">Meer informatie <Icon name="arrowRight" class="size-4" /></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="reveal mt-5 text-sm text-muted">Geen officieel partnerschap met de softwareleveranciers; de exacte werkzaamheden hangen af van uw toegang, inrichting en de afgesproken verantwoordelijkheden.</p>
    </div>
  </section>

  <!-- 6. WERKWIJZE -->
  <section id="werkwijze" class="section scroll-mt-24 bg-paper" aria-labelledby="werkwijze-title">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div>
        <SectionHeading id="werkwijze-title" eyebrow="Zo werkt het" title="In vier stappen naar extra capaciteit" />
        <ol class="mt-10">
          {steps.map((step, i) => (
            <li class="reveal relative flex gap-6 pb-9 last:pb-0">
              {i < steps.length - 1 && <span aria-hidden="true" class="absolute top-12 bottom-0 left-[1.4rem] w-px bg-line"></span>}
              <span class="relative inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-ink bg-paper font-display text-lg text-ink">{i + 1}</span>
              <div class="pt-1.5">
                <h3 class="text-xl">{step.title}</h3>
                <p class="mt-2 leading-relaxed text-muted">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="self-center">
        <Photo slot="werkwijze" class="reveal aspect-[4/3] lg:aspect-[4/5]" />
        <a href="/gegevensbescherming" class="link-arrow reveal mt-6">Hoe wij met uw gegevens omgaan <Icon name="arrowRight" class="size-4" /></a>
      </div>
    </div>
  </section>

  <!-- 7. OVER JOHN-LUKE -->
  <section class="section bg-mist" aria-labelledby="over-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
      <figure class="reveal relative mx-auto w-full max-w-sm">
        {showOwner ? (
          <Picture src={ownerPhoto!} alt={`${owner.name}, ${owner.role.toLowerCase()}`} formats={['avif', 'webp']} widths={[400, 700]} sizes="(min-width: 1024px) 24rem, 100vw" class="aspect-[3/4] w-full object-cover" />
        ) : (
          <Photo slot="advies" class="aspect-[3/4] w-full" sizes="(min-width: 1024px) 48rem, 150vw" />
        )}
        <span aria-hidden="true" class="absolute -top-3 -right-3 size-24 border-t border-r border-gold"></span>
      </figure>
      <div>
        <SectionHeading
          id="over-title"
          eyebrow="Over John-Luke Finance Outsourcing"
          title="Uw partner achter de financiële verwerking"
          intro={`${showOwner ? `Opgericht in 2025 door ${owner.name} (${owner.role.toLowerCase()}, ${owner.education}).` : 'Opgericht in 2025.'} Vanuit Suriname ondersteunen wij Nederlandse kantoren en mkb-bedrijven, met kennis van administratieve processen, moderne boekhoudsoftware en een gestructureerde werkwijze.`}
        />
        <ul class="reveal mt-7 grid gap-3 sm:grid-cols-2">
          {experience.map((e) => (
            <li class="flex items-start gap-3 text-ink"><span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-ink text-gold-light"><Icon name="check" class="size-3.5" stroke={2.5} /></span>{e}</li>
          ))}
        </ul>
        <a href="/over-ons" class="link-arrow reveal mt-9">Meer over ons <Icon name="arrowRight" class="size-4" /></a>
      </div>
    </div>
  </section>

  <!-- NIEUWS -->
  {latestNews.length > 0 && (
    <section id="nieuws" class="section bg-paper" aria-labelledby="nieuws-title">
      <div class="container-site">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <SectionHeading id="nieuws-title" eyebrow="Nieuws" title="Actueel bij John-Luke" />
          <a href="/nieuws" class="link-arrow reveal shrink-0 self-start lg:self-end">Alle nieuwsberichten <Icon name="arrowRight" class="size-4" /></a>
        </div>
        <ul class="mt-12 grid gap-8">
          {latestNews.map((entry) => <li><NewsCard entry={entry} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <!-- 8. FAQ -->
  <section id="faq" class="section bg-mist" aria-labelledby="faq-title">
    <div class="container-site grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <SectionHeading id="faq-title" eyebrow="Vragen" title="Veelgestelde vragen" intro="Over samenwerken op afstand, gegevensbescherming, verantwoordelijkheden en tarieven." />
        <a href="/veelgestelde-vragen" class="link-arrow reveal mt-8">Alle vragen bekijken <Icon name="arrowRight" class="size-4" /></a>
      </div>
      <FaqList items={generalFaq} />
    </div>
  </section>

  <!-- 9. CONTACT-CTA -->
  <CtaBand
    eyebrow="Kennismaken"
    title="Klaar voor extra financiële verwerkingscapaciteit?"
    text="Ontdek hoe John-Luke Finance Outsourcing uw kantoor kan ondersteunen."
    primary={{ label: 'Plan een kennismakingsgesprek', href: contactHref() }}
    secondary={{ label: 'Bekijk onze diensten', href: '/diensten' }}
  />
</BaseLayout>
