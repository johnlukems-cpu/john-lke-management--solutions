---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Logo from '@/components/Logo.astro';
import Photo from '@/components/Photo.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import FaqList from '@/components/FaqList.astro';
import ContactSection from '@/components/ContactSection.astro';
import { services, servicePath } from '@/data/services';
import { audiences, generalFaq, reasons, steps } from '@/data/content';
import { kennismakingHref } from '@/data/navigation';
import { faqSchema } from '@/lib/schema';
import { site } from '@/config/site';
---

<BaseLayout
  title="Administratiekantoor in Suriname | John-Luke Management Solutions"
  rawTitle
  description="Administratiekantoor in Suriname voor kleine en middelgrote ondernemingen: boekhouding, payroll en salarisadministratie, belastingaangifte en jaarrekening. Plan een kennismaking."
  schema={[faqSchema(generalFaq)]}
>
  <!-- 1. HERO -->
  <section class="relative overflow-hidden bg-paper">
    <div aria-hidden="true" class="absolute inset-y-0 right-0 hidden w-[38%] bg-mist lg:block"></div>
    <div class="container-site relative grid items-center gap-12 py-12 md:py-16 lg:grid-cols-[1.08fr_0.92fr] lg:gap-16 lg:py-24">
      <div class="reveal">
        <p class="eyebrow mb-6">Administratiekantoor in Suriname</p>
        <h1 class="text-[2.375rem] leading-[1.08] sm:text-[3.25rem] lg:text-[3.875rem]">
          Uw financiële administratie. <span class="italic text-gold-deep">Onze zorg.</span> Uw ruimte om te groeien.
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-muted">
          John-Luke Management Solutions ondersteunt kleine en middelgrote ondernemingen in Suriname met
          professionele administratie, salarisverwerking, belastingondersteuning en jaarrekeningen. Wij helpen
          ondernemers grip te houden op hun financiële administratie, zodat zij zich kunnen richten op hun onderneming.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={kennismakingHref} class="btn btn-primary">Plan een kennismaking <Icon name="arrowRight" class="size-4" /></a>
          <a href="#diensten" class="btn btn-outline">Bekijk onze diensten</a>
        </div>
        <ul class="mt-10 grid grid-cols-2 gap-x-6 gap-y-3 border-t border-line pt-7 sm:grid-cols-4">
          {services.map((s) => (
            <li>
              <a href={servicePath(s)} class="flex items-center gap-2.5 text-[0.9375rem] font-medium text-ink hover:text-gold-deep">
                <Icon name={s.icon} class="size-5 text-gold-deep" />{s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal relative">
        <Photo slot="hero" class="aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5]" sizes="(min-width: 1024px) 45vw, 100vw" priority mark={false} />
        <div class="absolute inset-0 grid place-items-center p-6">
          <div class="border border-line bg-paper/95 px-8 py-7 shadow-[0_30px_60px_-30px_rgba(0,0,0,.35)] backdrop-blur sm:px-12 sm:py-10">
            <Logo height={150} heightLg={190} link={false} priority />
          </div>
        </div>
        <span aria-hidden="true" class="absolute -top-3 -right-3 hidden size-24 border-t border-r border-gold lg:block"></span>
      </div>
    </div>
  </section>

  <!-- 2. INTRODUCTIE -->
  <section class="section bg-mist" aria-labelledby="intro-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <Photo slot="intro" class="reveal order-last aspect-[4/3] lg:order-first" />
      <div>
        <SectionHeading
          id="intro-title"
          eyebrow="Over John-Luke"
          title="Een betrouwbare partner voor uw financiële administratie"
          intro="Als ondernemer heeft u uw handen vol aan klanten, personeel en de dagelijkse gang van zaken. De administratie schuift dan al snel naar achteren. John-Luke Management Solutions neemt dat werk zorgvuldig van u over."
        />
        <div class="reveal mt-6 space-y-4 text-muted">
          <p>
            Wij verzorgen de administratie, payroll, belastingondersteuning en jaarrekening van kleine en
            middelgrote ondernemingen in Suriname. Persoonlijk, overzichtelijk en in begrijpelijke taal.
          </p>
        </div>
        <ul class="reveal mt-8 grid gap-3 sm:grid-cols-2">
          {['Persoonlijke begeleiding', 'Afgestemd op Suriname', 'Heldere afspraken in SRD', 'Vertrouwelijk en zorgvuldig'].map((p) => (
            <li class="flex items-center gap-3 font-medium text-ink">
              <span class="inline-flex size-6 items-center justify-center rounded-full bg-ink text-gold-light"><Icon name="check" class="size-3.5" stroke={2.5} /></span>{p}
            </li>
          ))}
        </ul>
        <a href="/over-ons" class="link-arrow reveal mt-9">Meer over ons <Icon name="arrowRight" class="size-4" /></a>
      </div>
    </div>
  </section>

  <!-- 3. DIENSTEN -->
  <section id="diensten" class="section bg-paper" aria-labelledby="diensten-title">
    <div class="container-site">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading
          id="diensten-title"
          eyebrow="Onze diensten"
          title="Vier diensten, één vertrouwd aanspreekpunt"
          intro="Kies één dienst of laat uw volledige financiële administratie door ons verzorgen. Alles sluit op elkaar aan."
        />
        <a href="/diensten" class="link-arrow reveal shrink-0 self-start lg:self-end">Alle diensten <Icon name="arrowRight" class="size-4" /></a>
      </div>
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {services.map((service, index) => <ServiceCard service={service} index={index} />)}
      </ul>
    </div>
  </section>

  <!-- 4. WAAROM -->
  <section class="section hatch-dark on-dark bg-ink text-on-dark" aria-labelledby="waarom-title">
    <div class="container-site">
      <SectionHeading
        id="waarom-title"
        eyebrow="Waarom John-Luke"
        title="Waarom ondernemers voor ons kiezen"
        intro="Geen grote beloftes, wel duidelijke afspraken en zorgvuldig werk. Dat is waar u op kunt rekenen."
        onDark
      />
      <ul class="mt-14 grid gap-px overflow-hidden border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((r) => (
          <li class="reveal bg-ink p-7 lg:p-8">
            <Icon name={r.icon} class="size-7 text-gold-light" stroke={1.3} />
            <h3 class="mt-5 text-xl !text-on-dark">{r.title}</h3>
            <p class="mt-3 leading-relaxed text-on-dark-muted">{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. WERKWIJZE -->
  <section id="werkwijze" class="section bg-paper" aria-labelledby="werkwijze-title">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div>
        <SectionHeading
          id="werkwijze-title"
          eyebrow="Onze werkwijze"
          title="Zo werken wij samen"
          intro="Van het eerste gesprek tot een administratie die loopt: in vier duidelijke stappen."
        />
        <ol class="mt-10 space-y-0">
          {steps.map((step, i) => (
            <li class="reveal relative flex gap-6 pb-9 last:pb-0">
              {i < steps.length - 1 && <span aria-hidden="true" class="absolute top-12 bottom-0 left-[1.4rem] w-px bg-line"></span>}
              <span class="relative inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-ink bg-paper font-display text-lg text-ink">{i + 1}</span>
              <div class="pt-1.5">
                <h3 class="text-xl">{step.title}</h3>
                <p class="mt-2 leading-relaxed text-muted">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <Photo slot="werkwijze" class="reveal aspect-[4/3] self-center lg:aspect-[4/5]" />
    </div>
  </section>

  <!-- 6. VOOR WIE -->
  <section id="voor-wie" class="section bg-mist" aria-labelledby="voor-wie-title">
    <div class="container-site">
      <SectionHeading
        id="voor-wie-title"
        eyebrow="Voor wie"
        title="Voor ondernemers in heel Suriname"
        intro="Of u nu net begint of een onderneming met personeel en een uitgebreide administratie heeft: wij stemmen onze ondersteuning af op uw situatie."
        align="center"
      />
      <div class="mt-14 grid gap-6 lg:grid-cols-2">
        {Object.values(audiences).map((group) => (
          <div class="reveal border border-line bg-paper p-7 lg:p-10">
            <div class="flex items-center gap-4">
              <span class="inline-flex size-12 items-center justify-center bg-ink text-gold-light"><Icon name={group.icon} class="size-6" /></span>
              <h3 class="text-2xl">{group.title}</h3>
            </div>
            <ul class="mt-7 divide-y divide-line border-t border-line">
              {group.items.map((item) => (
                <li class="flex items-center gap-4 py-4 text-ink">
                  <Icon name={item.icon} class="size-5 shrink-0 text-gold-deep" />{item.label}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section id="faq" class="section bg-paper" aria-labelledby="faq-title">
    <div class="container-site grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <SectionHeading id="faq-title" eyebrow="Vragen" title="Veelgestelde vragen" intro="Staat uw vraag er niet tussen? Neem gerust contact met ons op." />
        <a href="/veelgestelde-vragen" class="link-arrow reveal mt-8">Alle vragen bekijken <Icon name="arrowRight" class="size-4" /></a>
      </div>
      <FaqList items={generalFaq} />
    </div>
  </section>

  <!-- 8. CONTACT -->
  <ContactSection title={`Kennismaken met ${site.shortName}?`} />
</BaseLayout>
