---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { serviceBySlug, servicePath } from '@/data/services';
import { coreSoftware, softwarePath } from '@/data/software';
import { contactHref } from '@/data/navigation';
import { breadcrumbSchema, countryServiceSchema, faqSchema } from '@/lib/schema';

const origin = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '');
const crumbs = [{ name: 'België', path: '/belgie' }];
const cta = contactHref(undefined, 'belgie');
const description =
  'Financiële administratie uitbesteden in België: dagboeken, bank, btw-gegevens en Peppol-facturen verwerken voor Vlaamse boekhoud- en accountantskantoren.';

const workflows = [
  { icon: 'ledger' as const, title: 'Aankoop- en verkoopdagboeken', text: 'Inboeken van aankoop- en verkoopfacturen volgens uw rekeningstelsel en instructies, met controle op btw-codes en dubbele facturen.' },
  { icon: 'payroll' as const, title: 'Financiële dagboeken en bank', text: 'Verwerking van bankuittreksels en coda-bestanden zoals ze in uw pakket binnenkomen, afpunten van openstaande posten en bankaansluitingen.' },
  { icon: 'tax' as const, title: 'Voorbereiding btw-gegevens', text: 'Controle van btw-codes en voorbereiding van de gegevens voor de periodieke btw-aangifte, ter beoordeling en indiening door uw kantoor.' },
  { icon: 'report' as const, title: 'Periodeafsluitingen', text: 'Ondersteuning bij maand-, kwartaal- en jaarafsluitingen: aansluitingen, overzichten van openstaande posten en voorbereidende specificaties.' },
];

const related = ['financiele-administratie', 'debiteuren-crediteuren', 'financiele-controle', 'periode-en-jaarafsluiting', 'achterstanden', 'tijdelijke-capaciteit']
  .map(serviceBySlug)
  .filter((s) => s !== undefined);
const beSoftware = coreSoftware.filter((s) => s.slug === 'exact-online' || s.slug === 'nmbrs-accounting');

const faq = [
  { question: 'Werken jullie onder de verantwoordelijkheid van ons kantoor?', answer: 'Ja. Wij voeren administratieve verwerking uit in opdracht van en volgens de instructies van uw kantoor. De professionele beoordeling, fiscale keuzes, de btw-aangifte en de relatie met uw cliënten blijven bij uw kantoor. Wij voeren geen titel als accountant of belastingadviseur.' },
  { question: 'Wat betekent Peppol voor de verwerking?', answer: 'Sinds 1 januari 2026 is gestructureerde elektronische facturatie via Peppol verplicht tussen in België gevestigde btw-plichtige ondernemingen. Er komt minder intikwerk, maar controle blijft nodig: klopt de btw-code, is de factuur niet dubbel, hoort ze bij de juiste kostenpost? Dat controle- en uitzonderingswerk nemen wij over.' },
  { question: 'Kennen jullie de Belgische btw-regels?', answer: 'Wij werken volgens de btw-instructies van uw kantoor en controleren de coderingen in uw pakket. Bij twijfel of bijzondere fiscale situaties leggen wij de vraag altijd aan u voor. Fiscaal advies geven wij niet.' },
  { question: 'In welke taal werken jullie?', answer: 'In het Nederlands. Wij richten ons op Nederlandstalige kantoren in Vlaanderen en Brussel. Franstalige administraties bieden wij op dit moment niet aan.' },
];
---

<BaseLayout
  title="Boekhoudkundige ondersteuning België | John-Luke"
  rawTitle
  description={description}
  schema={[countryServiceSchema(origin, '/belgie', 'België', description), breadcrumbSchema(origin, crumbs), faqSchema(faq)]}
>
  <PageHero
    eyebrow="België"
    title="Financiële administratieve ondersteuning voor Belgische boekhoudkantoren."
    intro="Voor boekhoud- en accountantskantoren en fiduciaires in Vlaanderen: extra capaciteit voor het verwerken en controleren van dagboeken, bank en btw-gegevens — in het Nederlands en onder de verantwoordelijkheid van uw kantoor."
    crumbs={crumbs}
  >
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={cta} class="btn btn-gold">Plan een kennismakingsgesprek <Icon name="arrowRight" class="size-4" /></a>
      <a href="#werkwijze-be" class="btn btn-outline-light">Zo werken wij</a>
    </div>
  </PageHero>

  <section class="section bg-paper" aria-labelledby="context-title">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-20">
      <SectionHeading
        id="context-title"
        eyebrow="De Belgische praktijk"
        title="Moeilijk in te vullen vacatures, meer digitale facturen"
        intro="Belgische kantoren kampen al jaren met vacatures die moeilijk in te vullen zijn, en accountant staat in alle gewesten op de lijst van knelpuntberoepen. Tegelijk verandert de factuurstroom door Peppol."
      />
      <div class="reveal space-y-5 text-lg leading-relaxed text-muted">
        <p>
          Volgens de ITAA-Barometer 2026 vindt 84% van de kantoren het moeilijk om vacatures in te vullen. Sinds 1 januari
          2026 komen inkoopfacturen tussen Belgische ondernemingen bovendien gestructureerd binnen via Peppol.
        </p>
        <p>
          Minder overtikken betekent niet minder werk: elke factuur moet nog steeds juist gecodeerd, gecontroleerd en
          afgepunt worden. Dat terugkerende verwerkings- en controlewerk kunnen wij voor uw kantoor overnemen.
        </p>
        <p class="text-sm">Bronnen: ITAA-Barometer 2026; ITAA (knelpuntberoep, juli 2026); FOD Financiën en Unizo over de verplichte e-facturatie.</p>
      </div>
    </div>
  </section>

  <section id="werkwijze-be" class="section scroll-mt-24 bg-mist" aria-labelledby="proces-title">
    <div class="container-site">
      <SectionHeading id="proces-title" eyebrow="Werkzaamheden" title="Belgische boekhoudprocessen die wij ondersteunen" />
      <ul class="mt-12 grid gap-6 md:grid-cols-2">
        {workflows.map((p) => (
          <li class="reveal flex flex-col gap-4 border border-line bg-paper p-6 sm:flex-row sm:gap-5 sm:p-7">
            <span class="inline-flex size-12 shrink-0 items-center justify-center bg-ink text-gold-light"><Icon name={p.icon} class="size-6" /></span>
            <div class="min-w-0">
              <h3 class="text-xl [hyphens:auto]">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="reveal mt-10 grid gap-6 border border-line bg-paper p-7 lg:grid-cols-[auto_1fr] lg:p-8">
        <span class="inline-flex size-12 shrink-0 items-center justify-center bg-ink text-gold-light"><Icon name="shield" class="size-6" /></span>
        <div>
          <h3 class="text-xl">Onder de verantwoordelijkheid van uw kantoor</h3>
          <p class="mt-2 leading-relaxed text-muted">
            Wij werken uitsluitend in opdracht van boekhoud- en accountantskantoren, niet rechtstreeks voor Belgische
            ondernemingen. De professionele beoordeling, de btw-aangifte, de klantenlisting en de relatie met uw cliënten
            blijven bij uw kantoor. Wij voeren geen beschermde beroepstitel en geven geen fiscaal advies.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="software-title">
    <div class="container-site grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <SectionHeading id="software-title" eyebrow="Software" title="Exact Online en Nmbrs Accounting" intro="In Belgische kantoren werken wij vooral in Exact Online en Nmbrs Accounting (voorheen Yuki). Gebruikt uw kantoor een ander pakket? Bespreek het gerust met ons." />
      <ul class="grid gap-6 sm:grid-cols-2">
        {beSoftware.map((sw) => (
          <li class="reveal">
            <a href={softwarePath(sw)} class="group flex h-full flex-col border border-line bg-paper p-6 transition-colors hover:border-ink">
              <span class="font-display text-2xl text-ink">{sw.name}</span>
              {sw.badge && <span class="mt-1 text-xs font-semibold text-gold-deep">{sw.badge}</span>}
              <span class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-muted">{sw.helps}</span>
              <span class="link-arrow mt-4 self-start">Meer informatie <Icon name="arrowRight" class="size-4" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="diensten-title">
    <div class="container-site">
      <SectionHeading id="diensten-title" eyebrow="Diensten" title="Diensten voor Belgische kantoren" />
      <ul class="mt-10 grid gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((s) => (
          <li class="reveal">
            <a href={servicePath(s)} class="group flex items-start gap-3 border-b border-line pb-4">
              <Icon name={s.icon} class="mt-0.5 size-6 shrink-0 text-gold-deep" stroke={1.4} />
              <span>
                <span class="block font-semibold text-ink group-hover:underline">{s.name}</span>
                <span class="mt-1 block text-sm text-muted">{s.subtitle}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="faq-title">
    <div class="container-site grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <SectionHeading id="faq-title" eyebrow="Vragen" title="Veelgestelde vragen van Belgische kantoren" />
        <a href="/nederland" class="link-arrow reveal mt-8">Kantoor in Nederland? Bekijk onze Nederlandpagina <Icon name="arrowRight" class="size-4" /></a>
      </div>
      <FaqList items={faq} />
    </div>
  </section>

  <CtaBand
    eyebrow="België"
    title="Extra capaciteit voor uw boekhoudkantoor?"
    text="Bespreek in een vrijblijvend kennismakingsgesprek welke dagboeken, administraties en periodes wij voor uw kantoor kunnen verwerken."
    primary={{ label: 'Plan een kennismakingsgesprek', href: cta }}
    secondary={{ label: 'Bekijk onze diensten', href: '/diensten' }}
  />
</BaseLayout>
