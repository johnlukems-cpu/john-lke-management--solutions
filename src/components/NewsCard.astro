---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { formatDate, isoDate, newsPath, type NewsEntry } from '@/lib/news';

interface Props {
  entry: NewsEntry;
  /** Kopniveau binnen de pagina */
  headingLevel?: 'h2' | 'h3';
}
const { entry, headingLevel = 'h3' } = Astro.props;
const { data } = entry;
const Heading = headingLevel;
---

<article class="reveal group relative flex h-full flex-col border border-line bg-paper transition-[box-shadow,translate] duration-300 hover:-translate-y-1 hover:shadow-[0_24px_48px_-28px_rgba(0,0,0,.35)] sm:flex-row">
  {/* Volledige afbeelding, nooit bijgesneden */}
  <div class="flex shrink-0 items-start justify-center bg-mist p-4 sm:w-[42%] sm:p-5">
    <Image
      src={data.image}
      alt={data.imageAlt}
      widths={[360, 560, 800]}
      sizes="(min-width: 1024px) 22rem, (min-width: 640px) 40vw, 100vw"
      format="webp"
      quality={82}
      class="h-auto w-full"
    />
  </div>
  <div class="flex flex-1 flex-col p-6 lg:p-8">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
      <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>
      <span aria-hidden="true" class="text-gold">·</span>
      <span>{data.category}</span>
    </p>
    <Heading class="mt-3 text-2xl leading-snug">{data.title}</Heading>
    <p class="mt-3 flex-1 leading-relaxed text-muted">{data.intro}</p>
    <a href={newsPath(entry)} class="link-arrow mt-6 self-start after:absolute after:inset-0 after:content-['']">
      Lees meer <span class="sr-only">over {data.title}</span>
      <Icon name="arrowRight" class="size-4" />
    </a>
  </div>
</article>
