---
import Icon from './Icon.astro';
import ContactForm from './ContactForm.astro';
import SectionHeading from './SectionHeading.astro';
import type { IconName } from '@/data/icons';
import { hasDirectContact, phoneHref, site, socialLinks, whatsappUrl } from '@/config/site';

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  tone?: 'paper' | 'mist';
  /** 'algemeen' = formulier met vier categorieën; 'outsourcing' = vast formulier voor NL-kantoren */
  mode?: 'algemeen' | 'outsourcing';
  defaultCategory?: 'suriname' | 'outsourcing' | 'ai' | 'algemeen';
}
const {
  id = 'contact',
  eyebrow = 'Contact',
  title = 'Bespreek uw outsourcingmogelijkheden',
  intro = 'Vertel ons over uw kantoor en de werkzaamheden die u wilt uitbesteden. Wij reageren binnen één werkdag.',
  tone = 'mist',
  mode = 'outsourcing',
  defaultCategory,
} = Astro.props;

const { contact } = site;
const wa = whatsappUrl();
const tel = phoneHref();

interface Card {
  href: string;
  icon: IconName;
  title: string;
  text: string;
  external?: boolean;
  dark?: boolean;
}
const cards: Card[] = [
  wa && { href: wa, icon: 'whatsapp', title: 'WhatsApp', text: 'De snelste manier om ons te bereiken', external: true },
  contact.email && { href: `mailto:${contact.email}`, icon: 'mail', title: 'E-mail', text: contact.email, dark: true },
  tel && contact.phone && { href: tel, icon: 'phone', title: 'Telefoon', text: contact.phone, dark: true },
  ...socialLinks.map((s) => ({
    href: s.href,
    icon: (s.label === 'LinkedIn' ? 'linkedin' : s.label === 'Instagram' ? 'instagram' : 'globe') as IconName,
    title: s.label,
    text: `Volg ${site.name} op ${s.label}`,
    external: true,
    dark: true,
  })),
].filter(Boolean) as Card[];
---

<section id={id} class:list={['section', tone === 'mist' ? 'bg-mist' : 'bg-paper']} aria-labelledby={`${id}-title`}>
  <div class="container-site">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <SectionHeading id={`${id}-title`} eyebrow={eyebrow} title={title} intro={intro} />

        <ul class="reveal mt-10 space-y-4">
          {cards.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener noreferrer' : undefined}
                class="group flex items-center gap-5 border border-line bg-paper p-5 transition-colors hover:border-ink"
              >
                <span class:list={['inline-flex size-12 shrink-0 items-center justify-center rounded-full text-white', c.dark ? 'bg-ink' : 'bg-[#128c7e]']}>
                  <Icon name={c.icon} class="size-5" stroke={1.6} />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold text-ink">{c.title}</span>
                  <span class="block break-all text-sm text-muted">{c.text}</span>
                </span>
                <Icon name="arrowRight" class="size-5 text-gold-deep transition-transform group-hover:translate-x-1" />
              </a>
            </li>
          ))}
          {contact.address && (
            <li class="flex items-start gap-5 p-5">
              <Icon name="pin" class="mt-0.5 size-5 shrink-0 text-gold-deep" />
              <address class="not-italic text-muted">{contact.address.street}<br />{contact.address.city}, {site.country}</address>
            </li>
          )}
          {contact.openingHours && (
            <li class="flex items-center gap-5 px-5"><Icon name="clock" class="size-5 text-gold-deep" /><span class="text-muted">{contact.openingHours}</span></li>
          )}
          <li class="border-l-2 border-gold bg-paper p-5 text-muted">
            {hasDirectContact
              ? `Gevestigd in ${site.city}, Suriname. Wij ondersteunen Nederlandse administratie- en accountantskantoren op afstand.`
              : `Vul het formulier in en wij nemen binnen één werkdag contact met u op. Gevestigd in ${site.city}, Suriname; wij ondersteunen Nederlandse kantoren op afstand.`}
          </li>
        </ul>
      </div>

      <div class="reveal" id="formulier">
        <ContactForm id={`${id}-form`} mode={mode} defaultCategory={defaultCategory} />
      </div>
    </div>
  </div>
</section>
