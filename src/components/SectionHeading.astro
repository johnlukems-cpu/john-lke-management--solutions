---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  id?: string;
  align?: 'left' | 'center';
  onDark?: boolean;
  class?: string;
}
const { eyebrow, title, intro, id, align = 'left', onDark = false, class: className = '' } = Astro.props;
const center = align === 'center';
---

<div class:list={['reveal max-w-2xl', center && 'mx-auto text-center', className]}>
  {eyebrow && <p class:list={['eyebrow mb-5', center && 'eyebrow-center']}>{eyebrow}</p>}
  <h2 id={id} class:list={['text-[2rem] leading-[1.15] sm:text-[2.5rem] lg:text-[2.75rem]', onDark && '!text-on-dark']}>
    {title}
  </h2>
  {intro && <p class:list={['mt-5 text-lg leading-relaxed', onDark ? 'text-on-dark-muted' : 'text-muted']}>{intro}</p>}
</div>
