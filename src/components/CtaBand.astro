---
import Icon from './Icon.astro';
import { kennismakingHref } from '@/data/navigation';
import { whatsappUrl } from '@/config/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Klaar om uw administratie uit handen te geven?',
  text = 'Plan een vrijblijvende kennismaking. Wij bespreken uw onderneming en laten zien hoe wij u kunnen ondersteunen.',
} = Astro.props;
const wa = whatsappUrl();
---

<section class="hatch-dark on-dark bg-ink text-on-dark" aria-labelledby="cta-title">
  <div class="container-site py-16 lg:py-20">
    <div class="reveal flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow mb-5">Kennismaken</p>
        <h2 id="cta-title" class="text-[2rem] leading-[1.15] !text-on-dark sm:text-[2.5rem]">{title}</h2>
        <p class="mt-4 text-lg text-on-dark-muted">{text}</p>
      </div>
      <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
        <a href={kennismakingHref} class="btn btn-gold">Plan een kennismaking <Icon name="arrowRight" class="size-4" /></a>
        {wa ? (
          <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-outline-light"><Icon name="whatsapp" class="size-5" />WhatsApp ons</a>
        ) : (
          <a href="/contact" class="btn btn-outline-light">Neem contact op</a>
        )}
      </div>
    </div>
  </div>
</section>
