---
import Icon from './Icon.astro';
import { kennismakingHref } from '@/data/navigation';
import { whatsappUrl } from '@/config/site';

interface CtaLink {
  label: string;
  href: string;
}
interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  primary?: CtaLink;
  /** Tweede knop; standaard WhatsApp (indien ingesteld) of de contactpagina */
  secondary?: CtaLink;
}
const wa = whatsappUrl();
const {
  eyebrow = 'Kennismaken',
  title = 'Klaar voor de volgende stap?',
  text = 'Plan een vrijblijvende kennismaking. Wij bespreken uw situatie en laten zien hoe wij u kunnen ondersteunen.',
  primary = { label: 'Plan een kennismaking', href: kennismakingHref },
  secondary,
} = Astro.props;
---

<section class="hatch-dark on-dark bg-ink text-on-dark" aria-labelledby="cta-title">
  <div class="container-site py-16 lg:py-20">
    <div class="reveal flex flex-col gap-8 xl:flex-row xl:items-center xl:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow mb-5">{eyebrow}</p>
        <h2 id="cta-title" class="text-[2rem] leading-[1.15] !text-on-dark sm:text-[2.5rem]">{title}</h2>
        <p class="mt-4 text-lg text-on-dark-muted">{text}</p>
      </div>
      <div class="flex shrink-0 flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={primary.href} class="btn btn-gold">{primary.label} <Icon name="arrowRight" class="size-4" /></a>
        {secondary ? (
          <a href={secondary.href} class="btn btn-outline-light">{secondary.label}</a>
        ) : wa ? (
          <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-outline-light"><Icon name="whatsapp" class="size-5" />WhatsApp ons</a>
        ) : primary.label !== 'Neem contact op' ? (
          <a href="/contact" class="btn btn-outline-light">Neem contact op</a>
        ) : null}
      </div>
    </div>
  </div>
</section>
