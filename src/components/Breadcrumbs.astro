---
export interface Crumb {
  name: string;
  path: string;
}
interface Props {
  crumbs: Crumb[];
}
const all: Crumb[] = [{ name: 'Home', path: '/' }, ...Astro.props.crumbs];
---

<nav aria-label="Kruimelpad" class="mb-8">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-on-dark-muted">
    {
      all.map((c, i) => (
        <li class="flex items-center gap-2">
          {i === all.length - 1 ? (
            <span aria-current="page" class="text-on-dark">{c.name}</span>
          ) : (
            <>
              <a href={c.path} class="hover:text-on-dark">{c.name}</a>
              <span aria-hidden="true" class="text-gold">/</span>
            </>
          )}
        </li>
      ))
    }
  </ol>
</nav>
