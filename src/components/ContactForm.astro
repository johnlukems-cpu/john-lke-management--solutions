---
import Icon from './Icon.astro';
import type { IconName } from '@/data/icons';
import {
  ADMIN_COUNTS,
  AI_PROCESSES,
  CATEGORIES,
  OFFICE_TYPES,
  OUTSOURCING_TASKS,
  SOFTWARE,
  SURINAME_SERVICES,
} from '../../shared/form-options.js';

type Category = keyof typeof CATEGORIES;

interface Props {
  /** Unieke prefix voor id's (meerdere formulieren op één pagina) */
  id: string;
  /**
   * 'algemeen': bezoeker kiest een van de vier categorieën; de vervolgvelden passen zich aan.
   * 'outsourcing': vast outsourcingformulier voor Nederlandse kantoren.
   */
  mode?: 'algemeen' | 'outsourcing';
  /** Voorgekozen categorie (in algemene modus); de URL-parameter ?categorie= gaat voor. */
  defaultCategory?: Category;
  title?: string;
}

const { id, mode = 'algemeen', defaultCategory = 'algemeen', title } = Astro.props;
const fixed = mode === 'outsourcing';
const active: Category = fixed ? 'outsourcing' : defaultCategory;
const on = (cats: Category[]) => cats.includes(active);
const categoryIcons: Record<Category, IconName> = {
  suriname: 'pin',
  outsourcing: 'globe',
  ai: 'automation',
  algemeen: 'chat',
};
const heading = title ?? (fixed ? 'Vraag outsourcing aan' : 'Waarvoor neemt u contact op?');
---

<form
  action="/api/contact"
  method="post"
  class="contact-form border border-line bg-paper p-6 shadow-[0_30px_60px_-40px_rgba(0,0,0,.3)] sm:p-8 lg:p-10"
  data-mode={mode}
  novalidate
>
  {
    fixed ? (
      <>
        <h3 class="font-display text-2xl text-ink">{heading}</h3>
        <p class="mt-2 text-[0.9375rem] text-muted">Vertel ons over uw kantoor. Wij nemen binnen één werkdag contact met u op.</p>
        <input type="hidden" name="categorie" value="outsourcing" />
      </>
    ) : (
      <fieldset>
        <legend class="font-display text-2xl text-ink">{heading}</legend>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          {(Object.entries(CATEGORIES) as [Category, string][]).map(([value, labelText]) => (
            <label class="choice">
              <input type="radio" name="categorie" value={value} checked={value === active} />
              <span><Icon name={categoryIcons[value]} class="size-5 shrink-0" />{labelText}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )
  }

  {/* --- Outsourcing Nederland ------------------------------------------------ */}
  <fieldset data-for="outsourcing" disabled={!on(['outsourcing'])} hidden={!on(['outsourcing'])} class="mt-7">
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for={`${id}-o-bedrijf`} class="label">Bedrijfsnaam <span class="text-error" aria-hidden="true">*</span></label>
        <input id={`${id}-o-bedrijf`} name="bedrijf" type="text" class="field" autocomplete="organization" required maxlength="160" />
      </div>
      <div>
        <label for={`${id}-o-naam`} class="label">Contactpersoon <span class="text-error" aria-hidden="true">*</span></label>
        <input id={`${id}-o-naam`} name="naam" type="text" class="field" autocomplete="name" required maxlength="120" />
      </div>
      <div>
        <label for={`${id}-o-email`} class="label">E-mailadres <span class="text-error" aria-hidden="true">*</span></label>
        <input id={`${id}-o-email`} name="email" type="email" class="field" autocomplete="email" required maxlength="200" />
      </div>
      <div>
        <label for={`${id}-o-telefoon`} class="label">Telefoonnummer</label>
        <input id={`${id}-o-telefoon`} name="telefoon" type="tel" class="field" autocomplete="tel" maxlength="40" placeholder="+31" />
      </div>
      <div>
        <label for={`${id}-o-type`} class="label">Type kantoor <span class="text-error" aria-hidden="true">*</span></label>
        <select id={`${id}-o-type`} name="typeKantoor" class="field" required>
          <option value="">Maak een keuze</option>
          {Object.entries(OFFICE_TYPES).map(([v, l]) => <option value={v}>{l}</option>)}
        </select>
      </div>
      <div>
        <label for={`${id}-o-aantal`} class="label">Aantal administraties</label>
        <select id={`${id}-o-aantal`} name="aantalAdministraties" class="field">
          <option value="">Maak een keuze (optioneel)</option>
          {Object.entries(ADMIN_COUNTS).map(([v, l]) => <option value={v}>{l}</option>)}
        </select>
      </div>
    </div>

    <fieldset class="mt-6">
      <legend class="label">Gewenste werkzaamheden</legend>
      <div class="mt-1 grid gap-x-5 gap-y-2.5 sm:grid-cols-2">
        {Object.entries(OUTSOURCING_TASKS).map(([v, l]) => (
          <label class="check"><input type="checkbox" name="werkzaamheden" value={v} /><span>{l}</span></label>
        ))}
      </div>
    </fieldset>

    <fieldset class="mt-6">
      <legend class="label">Gebruikte boekhoudsoftware</legend>
      <div class="mt-1 grid grid-cols-2 gap-x-5 gap-y-2.5 sm:grid-cols-3">
        {Object.entries(SOFTWARE).map(([v, l]) => (
          <label class="check"><input type="checkbox" name="software" value={v} /><span>{l}</span></label>
        ))}
      </div>
      <label for={`${id}-o-software-anders`} class="sr-only">Andere software</label>
      <input id={`${id}-o-software-anders`} name="softwareAnders" type="text" class="field mt-3" maxlength="120" placeholder="Andere software (optioneel)" />
    </fieldset>

    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      <div>
        <label for={`${id}-o-start`} class="label">Gewenste startdatum</label>
        <input id={`${id}-o-start`} name="startdatum" type="date" class="field" />
      </div>
    </div>
    <div class="mt-5">
      <label for={`${id}-o-bericht`} class="label">Toelichting</label>
      <textarea id={`${id}-o-bericht`} name="bericht" rows="4" class="field" maxlength="4000" placeholder="Bijvoorbeeld: welke administraties, de gewenste frequentie of piekperiodes."></textarea>
    </div>
  </fieldset>

  {/* --- Suriname, AI & Automation en algemene vragen ---------------------------- */}
  {
    !fixed && (
      <fieldset data-for="suriname ai algemeen" disabled={!on(['suriname', 'ai', 'algemeen'])} hidden={!on(['suriname', 'ai', 'algemeen'])} class="mt-7">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for={`${id}-naam`} class="label">Naam <span class="text-error" aria-hidden="true">*</span></label>
            <input id={`${id}-naam`} name="naam" type="text" class="field" autocomplete="name" required maxlength="120" />
          </div>
          <div>
            <label for={`${id}-bedrijf`} class="label">Bedrijfsnaam</label>
            <input id={`${id}-bedrijf`} name="bedrijf" type="text" class="field" autocomplete="organization" maxlength="160" />
          </div>
          <div>
            <label for={`${id}-email`} class="label">E-mailadres <span class="text-error" aria-hidden="true">*</span></label>
            <input id={`${id}-email`} name="email" type="email" class="field" autocomplete="email" required maxlength="200" />
          </div>
          <div>
            <label for={`${id}-telefoon`} class="label">Telefoon of WhatsApp</label>
            <input id={`${id}-telefoon`} name="telefoon" type="tel" class="field" autocomplete="tel" maxlength="40" />
          </div>
          <fieldset data-for="suriname" disabled={!on(['suriname'])} hidden={!on(['suriname'])} class="sm:col-span-2">
            <label for={`${id}-dienst`} class="label">Dienst</label>
            <select id={`${id}-dienst`} name="dienst" class="field">
              <option value="">Maak een keuze (optioneel)</option>
              {Object.entries(SURINAME_SERVICES).map(([v, l]) => <option value={v}>{l}</option>)}
            </select>
          </fieldset>
          <fieldset data-for="ai" disabled={!on(['ai'])} hidden={!on(['ai'])} class="sm:col-span-2">
            <label for={`${id}-proces`} class="label">Welk proces wilt u verbeteren?</label>
            <select id={`${id}-proces`} name="proces" class="field">
              <option value="">Maak een keuze (optioneel)</option>
              {Object.entries(AI_PROCESSES).map(([v, l]) => <option value={v}>{l}</option>)}
            </select>
          </fieldset>
          <div class="sm:col-span-2">
            <label for={`${id}-bericht`} class="label">Bericht <span class="text-error" aria-hidden="true">*</span></label>
            <textarea id={`${id}-bericht`} name="bericht" rows="5" class="field" required maxlength="4000" placeholder="Vertel kort iets over uw onderneming en waar u hulp bij zoekt."></textarea>
          </div>
        </div>
      </fieldset>
    )
  }

  {/* Honeypot tegen spam — onzichtbaar voor bezoekers */}
  <div class="hp" aria-hidden="true">
    <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <input type="hidden" name="gestart" value="" />

  <label class="mt-6 flex items-start gap-3 text-sm text-muted">
    <input type="checkbox" name="akkoord" value="ja" required class="mt-0.5 size-4 shrink-0 accent-[#161616]" />
    <span>Ik ga akkoord met het verwerken van mijn gegevens om mijn aanvraag te beantwoorden, zoals beschreven in de <a href="/privacy" class="underline underline-offset-2 hover:text-ink">privacyverklaring</a>. <span class="text-error" aria-hidden="true">*</span></span>
  </label>

  <p class="form-status mt-6 hidden border-l-2 p-4 text-[0.9375rem]" role="status" aria-live="polite"></p>

  <button type="submit" class="btn btn-primary mt-6 w-full sm:w-auto">
    <span class="submit-label">{fixed ? 'Verstuur outsourcingaanvraag' : 'Verstuur aanvraag'}</span>
    <Icon name="arrowRight" class="size-4" />
  </button>
  <p class="mt-4 text-xs text-muted">Velden met <span class="text-error">*</span> zijn verplicht.</p>
</form>

<style>
  .contact-form :global(.label),
  .contact-form legend.label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  textarea.field {
    min-height: 7rem;
    resize: vertical;
  }
  fieldset[hidden] {
    display: none;
  }
  .choice {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .choice input {
    position: absolute;
    opacity: 0;
  }
  .choice span {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    border: 1px solid var(--color-line);
    padding: 0.85rem 1rem;
    font-weight: 500;
    line-height: 1.3;
    transition: border-color 150ms, background-color 150ms;
  }
  .choice:hover span {
    border-color: var(--color-muted);
  }
  .choice input:checked + span {
    border-color: var(--color-ink);
    background: var(--color-mist);
    box-shadow: inset 3px 0 0 var(--color-gold);
  }
  .choice input:focus-visible + span {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }
  .check {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.9375rem;
    color: var(--color-text);
    cursor: pointer;
  }
  .check input {
    margin-top: 0.2rem;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    accent-color: var(--color-ink);
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  import { site } from '@/config/site';

  const failed = site.contact.email
    ? `Het versturen is helaas niet gelukt. Probeer het later opnieuw of mail ons op ${site.contact.email}.`
    : 'Het versturen is helaas niet gelukt. Probeer het later opnieuw.';
  const MESSAGES = {
    success: 'Hartelijk dank voor uw aanvraag. Wij nemen zo snel mogelijk contact met u op.',
    invalid: 'Controleer de gemarkeerde velden en probeer het opnieuw.',
    failed,
  };
  /** Velden die meerdere waarden kunnen hebben (checkboxen) */
  const MULTI = new Set(['werkzaamheden', 'software']);

  for (const form of document.querySelectorAll<HTMLFormElement>('form.contact-form')) {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = form.querySelector<HTMLElement>('.submit-label')!;
    const labelText = label.textContent ?? '';
    const started = form.querySelector<HTMLInputElement>('input[name="gestart"]')!;
    started.value = String(Date.now());

    /** Toont alleen de velden van de gekozen categorie; verborgen velden worden niet verstuurd. */
    const applyCategory = () => {
      const checked = form.querySelector<HTMLInputElement>('input[name="categorie"]:checked');
      const fixedInput = form.querySelector<HTMLInputElement>('input[type="hidden"][name="categorie"]');
      const category = checked?.value ?? fixedInput?.value ?? 'algemeen';
      for (const fs of form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-for]')) {
        const enabled = (fs.dataset.for ?? '').split(' ').includes(category);
        fs.disabled = !enabled;
        fs.hidden = !enabled;
      }
    };

    // Voorselectie vanuit de URL (?categorie=…&dienst=…), alleen bij het algemene formulier
    const params = new URLSearchParams(location.search);
    if (form.dataset.mode === 'algemeen') {
      const cat = params.get('categorie');
      const radio = cat && form.querySelector<HTMLInputElement>(`input[name="categorie"][value="${CSS.escape(cat)}"]`);
      if (radio) radio.checked = true;
      const dienst = params.get('dienst');
      const select = form.querySelector<HTMLSelectElement>('select[name="dienst"]');
      if (dienst && select && [...select.options].some((o) => o.value === dienst)) select.value = dienst;
    }
    // Outsourcingformulier: werkzaamheid voorselecteren vanuit een dienstpagina (?dienst=…)
    if (form.dataset.mode === 'outsourcing') {
      const dienst = params.get('dienst');
      const box = dienst && form.querySelector<HTMLInputElement>(`input[name="werkzaamheden"][value="${CSS.escape(dienst)}"]`);
      if (box) box.checked = true;
    }
    form.querySelectorAll('input[name="categorie"]').forEach((r) => r.addEventListener('change', applyCategory));
    applyCategory();

    function show(kind: keyof typeof MESSAGES) {
      status.textContent = MESSAGES[kind];
      status.classList.remove('hidden', 'border-success', 'border-error');
      status.classList.add(kind === 'success' ? 'border-success' : 'border-error', 'bg-mist');
    }
    if (params.get('verzonden') === '1') show('success');
    if (params.get('fout') === '1') show('failed');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      // Validatie van de zichtbare (niet-uitgeschakelde) verplichte velden
      let firstInvalid: HTMLElement | null = null;
      for (const el of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[required]')) {
        if (el.closest('fieldset:disabled')) continue;
        const valid =
          el instanceof HTMLInputElement && el.type === 'checkbox'
            ? el.checked
            : el.checkValidity() && el.value.trim() !== '';
        el.setAttribute('aria-invalid', String(!valid));
        if (!valid && !firstInvalid) firstInvalid = el;
      }
      if (firstInvalid) {
        show('invalid');
        firstInvalid.focus();
        return;
      }

      const formData = new FormData(form);
      const payload: Record<string, string | string[]> = {};
      for (const key of new Set(formData.keys())) {
        const values = formData.getAll(key).map(String);
        payload[key] = MULTI.has(key) ? values : values[0];
      }

      button.disabled = true;
      label.textContent = 'Bezig met versturen…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = (await res.json().catch(() => ({}))) as { ok?: boolean };
        // Alleen een succesmelding als de server de verzending echt bevestigt
        if (res.ok && result.ok) {
          form.reset();
          applyCategory();
          started.value = String(Date.now());
          show('success');
        } else {
          show(res.status === 422 ? 'invalid' : 'failed');
        }
      } catch {
        show('failed');
      } finally {
        button.disabled = false;
        label.textContent = labelText;
        status.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    });
  }
</script>
