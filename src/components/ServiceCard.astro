---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { servicePath, type Service } from '@/data/services';

interface Props {
  service: Service;
  index: number;
}
const { service, index } = Astro.props;
---

<li class="reveal group relative flex flex-col border border-line bg-paper transition-[box-shadow,translate] duration-300 hover:-translate-y-1 hover:shadow-[0_24px_48px_-28px_rgba(0,0,0,.35)]">
  <Photo slot={service.photo} class="aspect-[16/10]" sizes="(min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
  <div class="flex flex-1 flex-col p-6 lg:p-7">
    <div class="flex items-center justify-between">
      <span class="inline-flex size-11 items-center justify-center border border-line text-ink">
        <Icon name={service.icon} class="size-5" />
      </span>
      {service.availability === 'op-aanvraag' ? (
        <span class="border border-gold px-2.5 py-1 text-xs font-medium text-gold-deep">Op aanvraag</span>
      ) : (
        <span aria-hidden="true" class="font-display text-sm text-gold-deep">0{index + 1}</span>
      )}
    </div>
    <h3 class="mt-5 text-2xl">{service.name}</h3>
    <p class="mt-1 text-sm font-medium text-gold-deep">{service.subtitle}</p>
    <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-muted">{service.summary}</p>
    <a href={servicePath(service)} class="link-arrow mt-6 self-start after:absolute after:inset-0 after:content-['']">
      Meer over {service.name}
      <Icon name="arrowRight" class="size-4" />
    </a>
  </div>
</li>
