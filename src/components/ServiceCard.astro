---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { priceLabel, servicePath, type Service } from '@/data/services';

interface Props {
  service: Service;
  index?: number;
}
const { service } = Astro.props;
---

<li class="reveal group relative flex flex-col overflow-hidden rounded-[3px] border border-line bg-off-white shadow-[0_1px_2px_rgba(37,35,41,.04),0_18px_40px_-30px_rgba(21,25,46,.35)] transition-[box-shadow,translate] duration-300 hover:-translate-y-1 hover:shadow-[0_1px_2px_rgba(37,35,41,.04),0_28px_56px_-30px_rgba(21,25,46,.45)]">
  <div class="relative">
    <Photo slot={service.photo} class="aspect-[16/9]" mark={false} sizes="(min-width: 1280px) 30vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
    <span class="absolute -bottom-6 left-6 inline-flex size-12 items-center justify-center rounded-[3px] border border-muted-copper/50 bg-off-white text-burgundy shadow-[0_10px_24px_-14px_rgba(21,25,46,.45)] lg:left-7">
      <Icon name={service.icon} class="size-[1.35rem]" />
    </span>
    {service.availability === 'op-aanvraag' && (
      <span class="absolute right-6 -bottom-3.5 rounded-[3px] border border-burgundy/60 bg-off-white px-2.5 py-1 text-xs font-semibold text-burgundy lg:right-7">Op aanvraag</span>
    )}
  </div>
  <div class="flex flex-1 flex-col px-6 pt-10 pb-6 lg:px-7 lg:pb-7">
    <div class="flex items-start justify-between gap-4">
      <h3 class="min-w-0 text-[1.75rem] leading-[1.1] !text-burgundy lg:text-[1.55rem] xl:text-[1.75rem]">{service.name}</h3>
      <Icon name="arrowRight" class="mt-2 size-5 shrink-0 text-burgundy transition-transform duration-300 group-hover:translate-x-1" />
    </div>
    <p class="mt-2 text-[0.9375rem] font-medium text-charcoal">{service.subtitle}</p>
    <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{service.summary}</p>
    <ul class="mt-4 flex-1 space-y-2">
      {service.tasks.slice(0, 3).map((t) => (
        <li class="flex items-start gap-2.5 text-sm text-charcoal"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-muted-copper" stroke={2.2} /><span class="min-w-0">{t}</span></li>
      ))}
    </ul>
    <p class="mt-5 border-t border-line pt-4 text-sm font-semibold text-charcoal">{priceLabel(service)}</p>
    <a href={servicePath(service)} class="link-arrow mt-4 self-start after:absolute after:inset-0 after:content-['']">
      Meer over {service.name}
      <Icon name="arrowRight" class="size-4" />
    </a>
  </div>
</li>
