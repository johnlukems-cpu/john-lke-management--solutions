---
import { icons, type IconName } from '@/data/icons';

interface Props {
  name: IconName;
  class?: string;
  /** Lijndikte */
  stroke?: number;
}
const { name, class: className = 'size-5', stroke = 1.5 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={icons[name]}
/>
