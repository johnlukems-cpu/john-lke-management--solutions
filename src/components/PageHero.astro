---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';
import GrowthLines from './GrowthLines.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, intro, crumbs = [] } = Astro.props;
---

<section class="lines relative overflow-hidden">
  <GrowthLines class="pointer-events-none absolute right-0 bottom-0 hidden h-full w-[46%] text-muted-copper md:block" />
  <div class="container-site relative py-14 md:py-20">
    {crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}
    <div class="max-w-3xl">
      {eyebrow && <p class="eyebrow mb-5">{eyebrow}</p>}
      <h1 class="text-[1.75rem] leading-[1.1] min-[400px]:text-[2.125rem] sm:text-5xl lg:text-[3.5rem]">{title}</h1>
      {intro && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{intro}</p>}
      <slot />
    </div>
  </div>
  <div aria-hidden="true" class="h-px bg-gradient-to-r from-transparent via-muted-copper to-transparent opacity-60"></div>
</section>
