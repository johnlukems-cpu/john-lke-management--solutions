# Alleen server-side (Vercel → Settings → Environment Variables). Nooit committen.
# Verplicht om het contactformulier te laten versturen:
RESEND_API_KEY=
# Ontvanger van de aanvragen (het zakelijke e-mailadres van John-Luke Finance Outsourcing)
CONTACT_TO=
# Afzender, op een bij Resend geverifieerd domein, bijv. "John-Luke Finance Outsourcing <noreply@uwdomein.sr>"
RESEND_FROM=

# Optioneel: definitief domein (canonical URL's en sitemap), bijv. https://www.uwdomein.sr
SITE_URL=
